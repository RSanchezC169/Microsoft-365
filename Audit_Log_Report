function Collect-DefenderIncidents {
    param([datetime]$From,[datetime]$To,[int]$Maximum)
    $rows=New-Object System.Collections.Generic.List[object];$seen=@{};$page=0;$normalizationErrors=0;$fallbackUsed=$false
    $fromUtc=$From.ToUniversalTime().ToString('yyyy-MM-ddTHH:mm:ssZ');$toUtc=$To.ToUniversalTime().ToString('yyyy-MM-ddTHH:mm:ssZ')
    $filter=[uri]::EscapeDataString("createdDateTime ge $fromUtc and createdDateTime le $toUtc")
    $next="https://graph.microsoft.com/v1.0/security/incidents?`$top=100&`$expand=alerts&`$filter=$filter"
    try{
        while($next -and $rows.Count -lt $Maximum){
            $page++;Update-SourceProgress -Status ("Defender incidents page {0}; {1} incident(s) collected" -f $page,$rows.Count) -Fraction ([Math]::Min(.9,$page*.1))
            try{$response=Invoke-MgGraphRequest -Method GET -Uri $next -OutputType PSObject -ErrorAction Stop}
            catch{
                $errorText=ConvertTo-SafeErrorText $_
                if($page -eq 1 -and -not $fallbackUsed -and $errorText -match '(?i)400|BadRequest'){
                    $fallbackUsed=$true;$page=0;$next='https://graph.microsoft.com/v1.0/security/incidents?$top=100'
                    Write-Log -Message ("The supported createdDateTime filter was rejected by this tenant/service. Retrying the documented v1.0 incidents endpoint without a server filter and applying the selected time range locally. Original response: {0}" -f $errorText) -Level 'WARN' -Area 'GRAPH'
                    continue
                }
                if($errorText -match '(?i)401|403|Forbidden|Unauthorized|AccessDenied|license|subscription'){
                    throw ("Defender incidents are unavailable. The endpoint requires SecurityIncident.Read.All, a supported role (Security Reader, Global Reader, Security Operator, or Security Administrator), and Microsoft Defender XDR incident licensing/access. Service response: $errorText")
                }
                throw
            }
            $items=@(Get-NestedValue $response 'value')
            foreach($item in $items){
                if($null -eq $item){continue};if($rows.Count -ge $Maximum){break}
                try{
                    $createdValue=Get-NestedValue $item 'createdDateTime';$created=$null;try{$created=[datetime]$createdValue}catch{}
                    if($created -and ($created -lt $From.ToUniversalTime() -or $created -gt $To.ToUniversalTime())){continue}
                    $id=[string](Get-NestedValue $item 'id');if($seen.ContainsKey($id)){continue};$seen[$id]=$true
                    $alerts=@(Get-NestedValue $item 'alerts')
                    $rows.Add([pscustomobject]@{CreatedDateTime=$createdValue;LastUpdateDateTime=Get-NestedValue $item 'lastUpdateDateTime';Id=$id;DisplayName=Get-NestedValue $item 'displayName';Severity=Get-NestedValue $item 'severity';Status=Get-NestedValue $item 'status';Classification=Get-NestedValue $item 'classification';Determination=Get-NestedValue $item 'determination';AssignedTo=Get-NestedValue $item 'assignedTo';AlertsCount=$alerts.Count;Comments=ConvertTo-FlatText (Get-NestedValue $item 'comments');RawJson=ConvertTo-CompactJson $item})
                }catch{$normalizationErrors++;Write-Log -Message ("Defender incident record was skipped because its schema could not be normalized: {0}" -f (ConvertTo-SafeErrorText $_)) -Level 'WARN' -Area 'NORMALIZE'}
            }
            if($response -is [System.Collections.IDictionary] -and $response.Contains('@odata.nextLink')){$next=[string]$response['@odata.nextLink']}else{$nextProperty=$response.PSObject.Properties['@odata.nextLink'];$next=if($nextProperty){[string]$nextProperty.Value}else{$null}}
        }
        $truncated=($next -and $rows.Count -ge $Maximum);$status=if($truncated -or $normalizationErrors){'Partial'}elseif($rows.Count){'Collected'}else{'VerifiedEmpty'}
        $details=("Used Microsoft Graph v1.0 /security/incidents with SecurityIncident.Read.All; pages={0}; local fallback={1}; normalization errors={2}." -f $page,$fallbackUsed,$normalizationErrors)
        Add-CollectionStatus -Source 'Defender Incidents' -Status $status -Count $rows.Count -Truncated $truncated -RequiredPermission 'SecurityIncident.Read.All plus Security Reader/Global Reader/Security Operator/Security Administrator and Defender XDR incident access' -Details $details
        Update-SourceProgress -Status ("Defender incidents complete: {0} incident(s)" -f $rows.Count) -Fraction 1
    }catch{
        $failureText=ConvertTo-SafeErrorText $_
        Add-CollectionStatus -Source 'Defender Incidents' -Status $(if($rows.Count){'Partial'}else{'Unavailable'}) -Count $rows.Count -RequiredPermission 'SecurityIncident.Read.All plus supported Entra role and Defender XDR incident licensing' -Details ("The documented v1.0 /security/incidents endpoint was unavailable after filtered and compatibility attempts. Confirm SecurityIncident.Read.All, a supported security role, and Defender XDR incident licensing/access. Service response: {0}" -f $failureText)
    }
    return $rows.ToArray()
}


