function Invoke-IsolatedAzureWorker {
    param([ValidateSet('Connect','Collect')][string]$Mode,[string]$Tenant,[datetime]$From=(Get-Date),[datetime]$To=(Get-Date),[int]$Maximum=50000,[switch]$ConfigurationOnly)
    $worker=New-IsolatedAzureWorkerScript;$output=Join-Path ([IO.Path]::GetTempPath()) ('M365AuditAzureOutput_{0}.json' -f [guid]::NewGuid().ToString('N'));$status=Join-Path ([IO.Path]::GetTempPath()) ('M365AuditAzureStatus_{0}.json' -f [guid]::NewGuid().ToString('N'))
    $hostPath=Join-Path $env:SystemRoot 'System32\WindowsPowerShell\v1.0\powershell.exe';if(-not (Test-Path $hostPath)){$hostPath='powershell.exe'}
    for($attempt=1;$attempt -le 2;$attempt++){
        Remove-Item $output,$status -Force -ErrorAction SilentlyContinue
        $arguments=@('-NoLogo','-NoProfile','-ExecutionPolicy','Bypass','-STA','-File',('"{0}"' -f $worker),'-Mode',$Mode,'-ContextPath',('"{0}"' -f $script:AzureContextPath),'-OutputPath',('"{0}"' -f $output),'-StatusPath',('"{0}"' -f $status),'-FromUtc',$From.ToUniversalTime().ToString('o'),'-ToUtc',$To.ToUniversalTime().ToString('o'),'-Maximum',[string]$Maximum)
        if($Tenant){$arguments+=@('-Tenant',('"{0}"' -f $Tenant))};if($ConfigurationOnly){$arguments+='-ConfigurationOnly'}
        $process=Start-Process -FilePath $hostPath -ArgumentList $arguments -PassThru -WindowStyle Normal
        while(-not $process.HasExited){
            if(Test-Path $status){try{$progress=Get-Content $status -Raw|ConvertFrom-Json;Update-SourceProgress -Status ([string](Get-NestedValue $progress 'Status')) -Fraction ([Math]::Min(1,[double](Get-NestedValue $progress 'Percent')/100))}catch{}}
            Start-Sleep -Milliseconds 750;$process.Refresh()
        }
        if(-not (Test-Path $output)){return [pscustomobject]@{Success=$false;RetryRequired=$false;Error=("Azure worker exited with code {0} without producing a result file." -f $process.ExitCode)}}
        try{$result=Get-Content $output -Raw|ConvertFrom-Json -ErrorAction Stop}catch{return [pscustomobject]@{Success=$false;RetryRequired=$false;Error=('Azure worker result could not be parsed: '+$_.Exception.Message)}}
        if((Get-NestedValue $result 'RetryRequired') -eq $true -and $attempt -lt 2){Write-Log -Message ([string](Get-NestedValue $result 'Error')) -Level 'WARN' -Area 'AZURE';continue}
        Remove-Item $output,$status -Force -ErrorAction SilentlyContinue;return $result
    }
}

function Connect-AzureAudit {
    param([string]$Tenant,[bool]$UseAzure)
    if(-not $UseAzure){Add-CollectionStatus -Source 'Azure connection' -Status 'Skipped' -Details 'Skipped by configuration.';return}
    try{
        Set-ProgressContext -Source 'Azure isolated sign-in' -Base 6 -Span 3
        $result=Invoke-IsolatedAzureWorker -Mode Connect -Tenant $Tenant
        if(-not (Get-NestedValue $result 'Success')){throw ([string](Get-NestedValue $result 'Error'))}
        $script:Connection.Azure=$true;$script:Connection.AzureConnectionDetails='Az.Accounts runs only in an isolated Windows PowerShell child process to avoid Azure.Core/Azure.Identity conflicts with Microsoft Graph.'
        if(-not $script:Connection.TenantId){$script:Connection.TenantId=[string](Get-NestedValue $result 'TenantId')};if(-not $script:Connection.Account){$script:Connection.Account=[string](Get-NestedValue $result 'Account')}
