function Collect-AzureAuditData {
    param([bool]$Enabled,[datetime]$From,[datetime]$To,[int]$Maximum,[switch]$ConfigurationOnly)
    if(-not $ConfigurationOnly){$script:SourceData['Azure Subscriptions']=@();$script:SourceData['Azure Diagnostic Settings']=@();$script:SourceData['Azure Activity Logs']=@()}
    if(-not $Enabled){foreach($name in @('Azure Subscriptions','Azure Diagnostic Settings','Azure Activity Logs')){Add-CollectionStatus -Source $name -Status 'Skipped' -Details 'Skipped by configuration.'};return}
    if(-not $script:Connection.Azure){foreach($name in @('Azure Subscriptions','Azure Diagnostic Settings','Azure Activity Logs')){Add-CollectionStatus -Source $name -Status 'Unavailable' -RequiredPermission 'Azure Reader or equivalent subscription access' -Details 'The isolated Azure connection was unavailable. Graph, Exchange, and Purview collection can continue.'};return}
    try{
        $result=Invoke-IsolatedAzureWorker -Mode Collect -Tenant $script:Connection.TenantId -From $From -To $To -Maximum $Maximum -ConfigurationOnly:$ConfigurationOnly
        if(-not (Get-NestedValue $result 'Success')){throw ([string](Get-NestedValue $result 'Error'))}
        $subscriptions=@((Get-NestedValue $result 'Subscriptions'));$diagnostics=@((Get-NestedValue $result 'DiagnosticSettings'));$rawActivities=@((Get-NestedValue $result 'ActivityLogs'));$errors=@((Get-NestedValue $result 'Errors'))
        $activityRows=New-Object System.Collections.Generic.List[object]
        foreach($item in $rawActivities){try{$activityRows.Add((ConvertFrom-AzureActivityEvent -Item $item -SubscriptionName ([string](Get-NestedValue $item '__subscriptionName'))))}catch{Add-CollectionStatus -Source 'Azure Activity Logs - record normalization' -Status 'Partial' -Count $activityRows.Count -Details (ConvertTo-SafeErrorText $_)}}
        # The service payload contains subscriptionId; recover the friendly name when the helper did not annotate it.
        foreach($row in $activityRows){if([string]::IsNullOrWhiteSpace([string]$row.SubscriptionName)){$sub=@($subscriptions|Where-Object{[string](Get-NestedValue $_ 'SubscriptionId') -eq [string]$row.SubscriptionId}|Select-Object -First 1);if($sub.Count){$row.SubscriptionName=[string](Get-NestedValue $sub[0] 'Name')}}}
        $script:SourceData['Azure Subscriptions']=$subscriptions;$script:SourceData['Azure Diagnostic Settings']=$diagnostics;$script:SourceData['Azure Activity Logs']=$activityRows.ToArray()
        Add-CollectionStatus -Source 'Azure Subscriptions' -Status $(if($subscriptions.Count){'Collected'}else{'VerifiedEmpty'}) -Count $subscriptions.Count -RequiredPermission 'Subscription read access' -Details 'Collected in an isolated Az.Accounts process.'
        $diagErrorCount=@($errors|Where-Object{[string](Get-NestedValue $_ 'Source') -eq 'DiagnosticSettings'}).Count
        Add-CollectionStatus -Source 'Azure Diagnostic Settings' -Status $(if($diagErrorCount){'Partial'}elseif($diagnostics.Count){'Collected'}else{'VerifiedEmpty'}) -Count $diagnostics.Count -RequiredPermission 'Microsoft.Insights/diagnosticSettings/read' -Details ("Isolated collection completed; source-scoped errors={0}." -f $diagErrorCount)
        foreach($errorRow in $errors){Add-CollectionStatus -Source ("Azure {0} - {1}" -f (Get-NestedValue $errorRow 'Source'),(Get-NestedValue $errorRow 'SubscriptionName')) -Status 'Unavailable' -Details ([string](Get-NestedValue $errorRow 'Error'))}
        if($ConfigurationOnly){Update-SourceProgress -Status ("Azure configuration inspection complete: {0} subscription(s), {1} diagnostic setting(s)" -f $subscriptions.Count,$diagnostics.Count) -Fraction 1;return}
        $activityErrorCount=@($errors|Where-Object{[string](Get-NestedValue $_ 'Source') -eq 'ActivityLog'}).Count;$truncated=[bool](Get-NestedValue $result 'Truncated')
        Add-CollectionStatus -Source 'Azure Activity Logs' -Status $(if($activityErrorCount -or $truncated){'Partial'}elseif($activityRows.Count){'Collected'}else{'VerifiedEmpty'}) -Count $activityRows.Count -Truncated $truncated -RequiredPermission 'Microsoft.Insights/eventtypes/values/read' -Details ("Native retention is 90 days. Isolated child-process collection preserved parent sessions; source-scoped errors={0}." -f $activityErrorCount)
        Update-SourceProgress -Status ("Azure collection complete: {0} activity event(s)" -f $activityRows.Count) -Fraction 1
    }catch{
        Add-CollectionStatus -Source 'Azure Activity Logs' -Status 'Unavailable' -RequiredPermission 'Azure Reader or Microsoft.Insights/eventtypes/values/read' -Details ((ConvertTo-SafeErrorText $_)+' The failure was isolated and did not invalidate Graph, Exchange, or Purview sessions.')
        if($ConfigurationOnly){Add-CollectionStatus -Source 'Azure Diagnostic Settings' -Status 'Unavailable' -Details (ConvertTo-SafeErrorText $_)}
    }
}


