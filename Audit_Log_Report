        [pscustomobject]@{Name='Entra Sign-ins';Workload='Microsoft Entra ID';Permission='AuditLog.Read.All plus supported Entra role';License='Native retention is 7 days for Free and 30 days for P1/P2';Enablement='Native report collection follows tenant subscription; no per-source activation timestamp is exposed';ChangedBy='';ChangedTime='';Limit='Authentication/authorization failures rejected before event creation might not produce the expected event.'}
        [pscustomobject]@{Name='Entra Directory Audits';Workload='Microsoft Entra ID';Permission='AuditLog.Read.All plus supported Entra role';License='Native retention is 7 days for Free and 30 days for P1/P2';Enablement='Native report collection follows tenant subscription; no per-source activation timestamp is exposed';ChangedBy='';ChangedTime='';Limit='Longer retention requires diagnostic export or qualifying Purview Audit retention.'}
        [pscustomobject]@{Name='Entra Provisioning';Workload='Microsoft Entra ID';Permission='AuditLog.Read.All and Directory.Read.All';License='Native retention follows Entra audit retention';Enablement='Events exist only for configured provisioning services';ChangedBy='';ChangedTime='';Limit='No events is not proof that no provisioning connector exists.'}
        [pscustomobject]@{Name='Entra Risk Detections';Workload='Microsoft Entra ID Protection';Permission='IdentityRiskEvent.Read.All';License='Entra ID Protection licensing required';Enablement='Service-generated when Identity Protection detections are available';ChangedBy='';ChangedTime='';Limit='Risk retention and detail vary by Entra tier and remediation state.'}
        [pscustomobject]@{Name='Entra Risky Users';Workload='Microsoft Entra ID Protection';Permission='IdentityRiskyUser.Read.All';License='Entra ID Protection licensing required';Enablement='Service-generated when Identity Protection is available';ChangedBy='';ChangedTime='';Limit='Remediated or dismissed users can disappear from active-risk views.'}
        [pscustomobject]@{Name='Defender Alerts';Workload='Microsoft Defender XDR';Permission='SecurityAlert.Read.All';License='Relevant Defender product licenses and portal access';Enablement='Product-specific onboarding; one tenant-wide activation timestamp is not exposed by this API';ChangedBy='';ChangedTime='';Limit='Retention and alert coverage differ by Defender product.'}
        [pscustomobject]@{Name='Defender Incidents';Workload='Microsoft Defender XDR';Permission='SecurityIncident.Read.All';License='Microsoft Defender XDR incident access';Enablement='Generated from correlated alerts after product onboarding';ChangedBy='';ChangedTime='';Limit='Incident availability depends on products, correlation, licensing, and RBAC.'}
        [pscustomobject]@{Name='Conditional Access Policies';Workload='Microsoft Entra ID';Permission='Policy.Read.All plus a supported Entra role';License='Conditional Access generally requires Entra ID P1/P2 for enforcement';Enablement=("Current policies: {0}; enabled: {1}; report-only: {2}; disabled: {3}" -f @($script:SourceData['Conditional Access Policies']).Count,@($script:SourceData['Conditional Access Policies']|Where-Object State -eq 'enabled').Count,@($script:SourceData['Conditional Access Policies']|Where-Object State -eq 'enabledForReportingButNotEnforced').Count,@($script:SourceData['Conditional Access Policies']|Where-Object State -eq 'disabled').Count);ChangedBy=$(if($caChange.Count){$caChange[0].InitiatedBy}else{''});ChangedTime=$(if($caChange.Count){$caChange[0].ActivityDateTime}else{''});Limit='Current policy state is not a permanent version history; change attribution is limited by directory-audit retention.'}
        [pscustomobject]@{Name='Azure Activity Logs';Workload='Azure Resource Manager';Permission='Azure Reader or Microsoft.Insights/eventtypes/values/read';License='Included Azure platform log; subscription access required';Enablement=("Platform log available for {0} visible subscription(s); {1} diagnostic export setting(s) found" -f @($script:SourceData['Azure Subscriptions']).Count,@($script:SourceData['Azure Diagnostic Settings']).Count);ChangedBy=$(if($azureDiagChange.Count){$azureDiagChange[0].Caller}else{''});ChangedTime=$(if($azureDiagChange.Count){$azureDiagChange[0].EventTimestamp}else{''});Limit='Native retention is 90 days. Diagnostic destinations can retain longer, but destination retention is not inferred.'}
        [pscustomobject]@{Name='Secure Score History';Workload='Microsoft Defender / Microsoft 365 security posture';Permission='SecurityEvents.Read.All';License='Secure Score availability depends on tenant products and permissions';Enablement='Service-calculated posture data; no tenant audit activation switch is exposed';ChangedBy='';ChangedTime='';Limit='Secure Score is posture data, not proof that controls were or were not used in a specific event.'}
    )
    foreach($source in $sources){
        $ret=@($script:RetentionAssessmentRows|Where-Object Source -eq $source.Name|Select-Object -First 1)
        if($source.Name -eq 'Entra Risk Detections' -or $source.Name -eq 'Entra Risky Users'){$ret=@($script:RetentionAssessmentRows|Where-Object Source -eq 'Entra risky sign-ins and detections'|Select-Object -First 1)}
        if($source.Name -eq 'Defender Alerts' -or $source.Name -eq 'Defender Incidents'){$ret=@($script:RetentionAssessmentRows|Where-Object Source -eq 'Defender alerts and incidents'|Select-Object -First 1)}
        if($source.Name -eq 'Conditional Access Policies'){$ret=@($script:RetentionAssessmentRows|Where-Object Source -eq 'Conditional Access policy configuration'|Select-Object -First 1)}
