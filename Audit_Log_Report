function Update-ReportProgress {
    param(
        [string]$Activity,
        [string]$Status,
        [ValidateRange(0,100)][int]$Percent,
        [int]$CurrentItem=0,
        [int]$TotalItems=0
    )
    $estimateStart=if($script:ProgressContext -and $script:ProgressContext.Source -eq $Activity -and $script:ProgressContext.Started){$script:ProgressContext.Started}else{$script:ProgressStarted}
    $elapsed=if ($estimateStart) { ((Get-Date)-$estimateStart).TotalSeconds } else { 0 }
    $secondsRemaining=-1
    if ($CurrentItem -gt 0 -and $TotalItems -gt $CurrentItem -and $elapsed -gt 0) {
        $secondsRemaining=[int][Math]::Max(0,($elapsed/$CurrentItem)*($TotalItems-$CurrentItem))
    }
    $estimate=if ($secondsRemaining -ge 0) { " Estimated remaining: $([TimeSpan]::FromSeconds($secondsRemaining).ToString('hh\:mm\:ss'))." } else { ' Remaining time depends on service paging and throttling.' }
    $fullStatus=("{0}{1} Elapsed: {2}." -f $Status,$estimate,([TimeSpan]::FromSeconds($elapsed).ToString('hh\:mm\:ss')))
    try { Write-Progress -Id 1 -Activity $Activity -Status $fullStatus -PercentComplete $Percent -SecondsRemaining $secondsRemaining }
    catch { }
    if ($script:ProgressForm -and -not $script:ProgressForm.IsDisposed) {
        try {
            $script:ProgressActivityLabel.Text=$Activity
            $script:ProgressStatusLabel.Text=$fullStatus
            $script:ProgressBar.Value=[Math]::Min(100,[Math]::Max(0,$Percent))
            [System.Windows.Forms.Application]::DoEvents()
        }
        catch { }
    }
    Write-Log -Message ("{0}% - {1} - {2}" -f $Percent,$Activity,$Status) -Level 'DEBUG' -Area 'PROGRESS'
}

function Update-SourceProgress {
    param([string]$Status,[double]$Fraction=0,[int]$CurrentItem=0,[int]$TotalItems=0)
    $fraction=[Math]::Min(1,[Math]::Max(0,$Fraction))
    $percent=[int]($script:ProgressContext.Base+($script:ProgressContext.Span*$fraction))
    Update-ReportProgress -Activity $script:ProgressContext.Source -Status $Status -Percent $percent -CurrentItem $CurrentItem -TotalItems $TotalItems
}

