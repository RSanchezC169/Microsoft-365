function Disconnect-ExistingSessions {
    try { if (Get-Command Disconnect-ExchangeOnline -ErrorAction SilentlyContinue) { Disconnect-ExchangeOnline -Confirm:$false -ErrorAction SilentlyContinue | Out-Null } } catch { }
    try { if (Get-Command Disconnect-IPPSSession -ErrorAction SilentlyContinue) { Disconnect-IPPSSession -Confirm:$false -ErrorAction SilentlyContinue | Out-Null } } catch { }
    try { if (Get-Command Disconnect-MgGraph -ErrorAction SilentlyContinue) { Disconnect-MgGraph -ErrorAction SilentlyContinue | Out-Null } } catch { }
    # Azure runs in an isolated child process; never import or disconnect Az.Accounts here.
    try{Remove-Item $script:AzureContextPath,$script:AzureWorkerPath -Force -ErrorAction SilentlyContinue}catch{}
}

function Connect-ExchangeAndPurview {
    param([string]$Mode,[string]$Tenant,[string]$UPN,[bool]$UsePurview)
    if (-not (Ensure-Module -Name 'ExchangeOnlineManagement')) {
        Add-CollectionStatus -Source 'Exchange Online connection' -Status 'Unavailable' -Details 'ExchangeOnlineManagement could not be installed or imported.'
        return
    }
    try {
        $command = Get-Command Connect-ExchangeOnline -ErrorAction Stop | Select-Object -First 1
        $params = @{ ShowBanner=$false; ErrorAction='Stop' }
        if ($Mode -eq 'Delegated') {
            if ([string]::IsNullOrWhiteSpace($Tenant)) { throw 'Delegated mode requires a tenant ID or primary onmicrosoft.com domain.' }
            if (-not $command.Parameters.ContainsKey('DelegatedOrganization')) { throw 'This ExchangeOnlineManagement version does not support DelegatedOrganization.' }
            $params['DelegatedOrganization']=$Tenant
        }
        if ($UPN -and $command.Parameters.ContainsKey('UserPrincipalName')) { $params['UserPrincipalName']=$UPN }
        & $command @params | Out-Null
        $org = Get-OrganizationConfig -ErrorAction Stop
        $script:Connection.Exchange=$true
        if($UPN){$script:Connection.Account=$UPN}
        if (-not $script:Connection.Tenant) { $script:Connection.Tenant=[string]$org.Name }
        Add-CollectionStatus -Source 'Exchange Online connection' -Status 'Collected' -Count 1 -Details ("Verified with Get-OrganizationConfig: {0}" -f $org.Name)
    }
    catch {
        Add-CollectionStatus -Source 'Exchange Online connection' -Status 'Unavailable' -Details (ConvertTo-SafeErrorText $_)
    }

    if (-not $UsePurview) {
        Add-CollectionStatus -Source 'Microsoft Purview connection' -Status 'Skipped' -Details 'Skipped by configuration.'
        return
    }
    try {
        $command = Get-Command Connect-IPPSSession -ErrorAction Stop | Select-Object -First 1
        $params = @{ ShowBanner=$false; ErrorAction='Stop' }
        if ($command.Parameters.ContainsKey('EnableErrorReporting')) { $params['EnableErrorReporting']=$true }
        if ($Mode -eq 'Delegated') {
            if (-not $command.Parameters.ContainsKey('DelegatedOrganization')) { throw 'This ExchangeOnlineManagement version does not support delegated Purview connection.' }
            $params['DelegatedOrganization']=$Tenant
            if ($command.Parameters.ContainsKey('AzureADAuthorizationEndpointUri')) { $params['AzureADAuthorizationEndpointUri']="https://login.microsoftonline.com/$Tenant" }
        }
        if ($UPN -and $command.Parameters.ContainsKey('UserPrincipalName')) { $params['UserPrincipalName']=$UPN }
        & $command @params | Out-Null
        if (-not (Get-Command Search-UnifiedAuditLog -ErrorAction SilentlyContinue)) { throw 'Connected, but Search-UnifiedAuditLog is unavailable. Verify Purview Audit roles.' }
        $script:Connection.Purview=$true
        Add-CollectionStatus -Source 'Microsoft Purview connection' -Status 'Collected' -Count 1 -Details 'Search-UnifiedAuditLog is available.'
    }
    catch {
        Add-CollectionStatus -Source 'Microsoft Purview connection' -Status 'Unavailable' -RequiredPermission 'Purview Audit/Audit Reader role' -Details (ConvertTo-SafeErrorText $_)
    }
}

function Connect-GraphAudit {
    param([string]$Tenant,[bool]$UseGraph,[bool]$UseSecurity,[bool]$UseConditionalAccess,[bool]$UseSecureScore)
    if (-not $UseGraph) {
        Add-CollectionStatus -Source 'Microsoft Graph connection' -Status 'Skipped' -Details 'Skipped by configuration.'
        return
    }
    if (-not (Ensure-Module -Name 'Microsoft.Graph.Authentication')) {
        Add-CollectionStatus -Source 'Microsoft Graph connection' -Status 'Unavailable' -Details 'Microsoft.Graph.Authentication could not be installed or imported.'
        return
    }
    $coreScopes = @('AuditLog.Read.All','Directory.Read.All')
    $allScopes = @($coreScopes)+@('LicenseAssignment.Read.All')
    if ($UseSecurity) { $allScopes += @('IdentityRiskEvent.Read.All','IdentityRiskyUser.Read.All','SecurityAlert.Read.All','SecurityIncident.Read.All') }
    if ($UseConditionalAccess) { $allScopes += 'Policy.Read.All' }
    if ($UseSecureScore) { $allScopes += 'SecurityEvents.Read.All' }
    $allScopes=@($allScopes | Sort-Object -Unique)
    try {
        $params = @{ Scopes=$allScopes; ContextScope='Process'; NoWelcome=$true; ErrorAction='Stop' }
        if ($Tenant) { $params['TenantId']=$Tenant }
        Connect-MgGraph @params | Out-Null
        $context = Get-MgContext
        if (-not $context) { throw 'Microsoft Graph did not return a connection context.' }
        $script:Connection.Graph=$true
        $script:Connection.Account=[string](Get-NestedValue $context 'Account')
        if (-not $script:Connection.Tenant) { $script:Connection.Tenant=[string](Get-NestedValue $context 'TenantId') }
        $script:Connection.GraphScopes=((Get-NestedValue $context 'Scopes') -join ', ')
        Add-CollectionStatus -Source 'Microsoft Graph connection' -Status 'Collected' -Count 1 -Details ("TenantId={0}; Account={1}" -f (Get-NestedValue $context 'TenantId'),(Get-NestedValue $context 'Account'))
    }
    catch {
        $firstError = ConvertTo-SafeErrorText $_
        if ($allScopes.Count -gt $coreScopes.Count) {
            Write-Log -Message "Full Graph scope connection failed; retrying with core audit scopes only. $firstError" -Level 'WARN' -Area 'CONNECT'
            try {
                $params = @{ Scopes=$coreScopes; ContextScope='Process'; NoWelcome=$true; ErrorAction='Stop' }
                if ($Tenant) { $params['TenantId']=$Tenant }
                Connect-MgGraph @params | Out-Null
                $context = Get-MgContext
                $script:Connection.Graph=$true
                $script:Connection.Account=[string](Get-NestedValue $context 'Account')
                if (-not $script:Connection.Tenant) { $script:Connection.Tenant=[string](Get-NestedValue $context 'TenantId') }
                $script:Connection.GraphScopes=((Get-NestedValue $context 'Scopes') -join ', ')
                Add-CollectionStatus -Source 'Microsoft Graph connection' -Status 'Partial' -Count 1 -Details 'Connected with core AuditLog.Read.All and Directory.Read.All after the expanded scope request failed. Tenant licensing, Identity Protection, Defender, Conditional Access, or Secure Score collectors may be unavailable, but core Graph audit sources remain usable.'
                return
            }
            catch { $firstError += ' | Core-scope retry: ' + (ConvertTo-SafeErrorText $_) }
        }
        Add-CollectionStatus -Source 'Microsoft Graph connection' -Status 'Unavailable' -RequiredPermission 'AuditLog.Read.All and Directory.Read.All' -Details $firstError
    }
}

function Resolve-TenantIdentity {
    $tenantId=[string]$script:Connection.TenantId;$tenantName=[string]$script:Connection.TenantName
    if($script:Connection.Graph){
        try{
            $context=Get-MgContext
            if($context){$tenantId=[string](Get-NestedValue $context 'TenantId');if(-not $script:Connection.Account){$script:Connection.Account=[string](Get-NestedValue $context 'Account')}}
            $response=Invoke-MgGraphRequest -Method GET -Uri 'https://graph.microsoft.com/v1.0/organization?$select=id,displayName,verifiedDomains' -OutputType PSObject -ErrorAction Stop
            $organizations=@(Get-NestedValue $response 'value')
            if($organizations.Count){$tenantId=[string](Get-NestedValue $organizations[0] 'id');$tenantName=[string](Get-NestedValue $organizations[0] 'displayName')}
        }catch{Write-Log -Message ("Tenant organization lookup failed; connection identifiers will be used: {0}" -f (ConvertTo-SafeErrorText $_)) -Level 'WARN' -Area 'CONNECT'}
    }
    if(-not $tenantName -and $script:Connection.Exchange){
        try{$organization=Get-OrganizationConfig -ErrorAction Stop;$tenantName=[string](Get-NestedValue $organization 'Name')}catch{}
    }
    if(-not $tenantId){$tenantId=[string]$script:Connection.Tenant}
    if(-not $tenantName){$tenantName=[string]$script:Connection.Tenant}
    $script:Connection.TenantId=$tenantId;$script:Connection.TenantName=$tenantName
    $script:ResolvedTenantLabel=if($tenantName -and $tenantId -and $tenantName -ne $tenantId){"$tenantName ($tenantId)"}elseif($tenantId){$tenantId}elseif($tenantName){$tenantName}else{'Unresolved tenant'}
    if(-not $script:Connection.Tenant){$script:Connection.Tenant=$tenantId}
    Write-Log -Message ("Resolved tenant context: {0}" -f $script:ResolvedTenantLabel) -Level 'SUCCESS' -Area 'CONNECT'
    return $script:ResolvedTenantLabel
}

function New-IsolatedAzureWorkerScript {
    if(Test-Path -LiteralPath $script:AzureWorkerPath){return $script:AzureWorkerPath}
    $worker=@'
param(
