    $script:RetentionAssessmentRows.Add([pscustomobject]@{ Source='Exchange Admin Audit Log'; RetentionDays=$adminDays; SearchableFor=$(if($adminDays){"$adminDays days from live AdminAuditLogAgeLimit"}else{'Retention not exposed or configuration unavailable'}); OldestSearchableDate=$(if($adminDays){$now.AddDays(-$adminDays)}else{$null}); OldestPotentialDate=$(if($adminDays){$now.AddDays(-$adminDays)}else{$null}); Basis='Get-AdminAuditLogConfig.AdminAuditLogAgeLimit'; Confidence=$(if($adminDays){'Configuration-derived'}else{'Unknown'}); Limitation='Search-AdminAuditLog and Unified Audit are separate query paths and can expose overlapping Exchange administration events.' })

