function Add-Finding {
    param(
        [ValidateSet('CRITICAL','HIGH','MEDIUM','LOW','INFO')][string]$Severity,
        [string]$Category,[string]$Rule,[AllowNull()][object]$Time,[string]$Actor,[string]$IPAddress,
