:root{--blue:#0f6cbd;--ink:#1f2937;--muted:#64748b;--line:#cbd5e1;--bg:#f4f7fb;--critical:#8b0000;--high:#c62828;--medium:#b26a00;--low:#2b6cb0;--good:#107c10}
*{box-sizing:border-box}body{margin:0;font-family:Segoe UI,Arial,sans-serif;background:var(--bg);color:var(--ink)}
header{background:linear-gradient(120deg,#0b4f83,#0f6cbd);color:#fff;padding:24px 30px}header h1{margin:0 0 8px;font-size:28px}header p{margin:0;opacity:.9}
.nav{position:sticky;top:0;z-index:20;background:#fff;border-bottom:1px solid var(--line);padding:8px 12px;display:flex;gap:6px;flex-wrap:wrap;box-shadow:0 2px 8px rgba(0,0,0,.08)}
.tab-button{border:1px solid #b7c4d1;background:#f8fafc;padding:8px 11px;border-radius:5px;cursor:pointer;font-weight:600;color:#334155}.tab-button:hover,.tab-button.active{background:var(--blue);color:#fff;border-color:var(--blue)}
main{padding:18px;max-width:1900px;margin:auto}.tab{display:none}.tab.active{display:block}.intro,.notice,section{background:#fff;border:1px solid var(--line);border-radius:8px;padding:15px;margin-bottom:14px}.intro{border-left:5px solid var(--blue)}.notice{border-left:5px solid #ffb900;background:#fffbea}
h2{font-size:19px;margin:0 0 12px}.metrics{display:grid;grid-template-columns:repeat(6,minmax(130px,1fr));gap:12px;margin:14px 0}.metric{background:#fff;border:1px solid var(--line);border-top:5px solid var(--blue);border-radius:8px;padding:14px;text-align:center}.metric span{display:block;font-size:30px;font-weight:800}.metric.critical{border-top-color:var(--critical)}.metric.high{border-top-color:var(--high)}.metric.medium{border-top-color:var(--medium)}.metric.low{border-top-color:var(--low)}.metric.good{border-top-color:var(--good)}.metric.warning{border-top-color:#ffb900}
.grid.two{display:grid;grid-template-columns:1fr 2fr;gap:14px}dl{display:grid;grid-template-columns:150px 1fr;gap:7px;margin:0}dt{font-weight:700}dd{margin:0;word-break:break-word}.table-tools{display:flex;align-items:center;gap:12px;margin:8px 0}.table-tools input{min-width:340px;max-width:700px;width:45%;padding:8px;border:1px solid #94a3b8;border-radius:4px}.table-tools span{color:var(--muted);font-size:12px}.table-wrap{overflow:auto;max-height:72vh;border:1px solid var(--line);background:#fff}table{border-collapse:collapse;width:100%;font-size:12px}th,td{padding:7px 8px;border:1px solid #d8e0e8;text-align:left;vertical-align:top;max-width:520px;word-break:break-word}th{position:sticky;top:0;background:#eaf2f8;color:#12344d;z-index:2}tr:nth-child(even){background:#f8fafc}tr:hover{background:#fff8d6}.sev-critical{border-left:6px solid var(--critical)}.sev-high{border-left:6px solid var(--high)}.sev-medium{border-left:6px solid var(--medium)}.sev-low,.sev-info{border-left:6px solid var(--low)}.raw-cell pre{white-space:pre-wrap;word-break:break-all;max-width:900px;max-height:420px;overflow:auto;background:#0b1220;color:#d7e4f2;padding:10px}.raw-cell summary{cursor:pointer;color:var(--blue);font-weight:600}.empty{padding:18px;background:#f8fafc;border:1px dashed #94a3b8;color:var(--muted)}
@media(max-width:1000px){.metrics{grid-template-columns:repeat(2,1fr)}.grid.two{grid-template-columns:1fr}.table-tools input{width:100%;min-width:0}}
@media print{.nav,.table-tools{display:none}.tab{display:block!important}.table-wrap{max-height:none;overflow:visible}th{position:static}}
</style>
"@
    $scriptBlock=@"
<script>
function openTab(id,button){var tabs=document.getElementsByClassName('tab');for(var i=0;i<tabs.length;i++){tabs[i].className='tab';}var buttons=document.getElementsByClassName('tab-button');for(var j=0;j<buttons.length;j++){buttons[j].className='tab-button';}document.getElementById(id).className='tab active';button.className='tab-button active';window.scrollTo(0,0);return false;}
function filterTable(id,value){var table=document.getElementById(id);if(!table){return;}var filter=(value||'').toLowerCase();var rows=table.getElementsByTagName('tbody')[0].getElementsByTagName('tr');for(var i=0;i<rows.length;i++){var text=(rows[i].textContent||rows[i].innerText||'').toLowerCase();rows[i].style.display=(text.indexOf(filter)>=0)?'':'none';}}
</script>
"@
    $builder=New-Object Text.StringBuilder
    [void]$builder.AppendLine("<!doctype html><html><head><meta charset='utf-8'><meta name='viewport' content='width=device-width,initial-scale=1'><title>$script:ProductName</title>$css$scriptBlock</head><body>")
    [void]$builder.AppendLine("<header><h1>$script:ProductName</h1><p>Read-only multi-source audit collection and suspicious-activity triage | Version $script:ProductVersion</p></header><div class='nav'>")
    $index=0
    foreach ($entry in $tabs.GetEnumerator()) {
        $id='tab-'+$index
        $active=if ($index -eq 0) {' active'} else {''}
        [void]$builder.AppendLine("<button class='tab-button$active' onclick=`"return openTab('$id',this)`">$(ConvertTo-HtmlEncoded $entry.Key)</button>")
        $index++
    }
    [void]$builder.AppendLine('</div><main>')
    $index=0
    foreach ($entry in $tabs.GetEnumerator()) {
        $id='tab-'+$index; $active=if ($index -eq 0) {' active'} else {''}
        [void]$builder.AppendLine("<div id='$id' class='tab$active'>$($entry.Value)</div>")
        $index++
    }
    [void]$builder.AppendLine('</main></body></html>')
    [IO.File]::WriteAllText($path,$builder.ToString(),(New-Object Text.UTF8Encoding($true)))
    $script:ReportPath=$path
    Write-Log -Message "HTML report written to $path" -Level 'SUCCESS' -Area 'REPORT'
    return $path
}

function Start-M365AuditSecurityReport {
    [CmdletBinding()]
    param()
    $defaultEnd=if($null -ne $EndDate){[datetime]$EndDate}else{Get-Date};$defaultStart=if($null -ne $StartDate){[datetime]$StartDate}else{$defaultEnd.AddDays(-$DaysBack)}
    if($defaultStart -ge $defaultEnd){throw 'StartDate must be earlier than EndDate.'}
    if(-not (Test-Path -LiteralPath $ReportFolder)){try{New-Item -Path $ReportFolder -ItemType Directory -Force|Out-Null}catch{throw "Could not create report folder '$ReportFolder': $($_.Exception.Message)"}}
    $script:LogFile=Join-Path $ReportFolder ("M365_Audit_Security_{0}.log" -f (Get-Date -Format 'yyyyMMdd_HHmmss'))
    try{Set-ExecutionPolicy -Scope Process -ExecutionPolicy Unrestricted -Force -ErrorAction SilentlyContinue}catch{}
    Invoke-EnvironmentValidation
    foreach($row in $script:EnvironmentRows){Write-Log -Message ("{0}: {1}" -f $row.Check,$row.Details) -Level $(if($row.Status -eq 'FAIL'){'ERROR'}elseif($row.Status -eq 'WARN'){'WARN'}elseif($row.Status -eq 'PASS'){'SUCCESS'}else{'INFO'}) -Area 'PREFLIGHT'}
    $blocking=@($script:EnvironmentRows|Where-Object Status -eq 'FAIL');if($blocking.Count){throw ('Preflight failed: '+(($blocking|ForEach-Object{$_.Check+': '+$_.Details}) -join ' | '))}

    $allSources=@('Purview Unified Audit Log','Exchange Admin Audit Log','Audit Configuration Change Evidence','Entra Sign-ins','Entra Directory Audits','Entra Provisioning','Entra Risk Detections','Entra Risky Users','Defender Alerts','Defender Incidents','Conditional Access Policies','Azure Subscriptions','Azure Diagnostic Settings','Azure Activity Logs','Secure Score History','Secure Score Control Profiles','Secure Score Control Results','Audit Configuration','Tenant Licensing','Audit Source Configuration','Retention Assessment','Regression Expectations')
    foreach($name in $allSources){$script:SourceData[$name]=@()}

    # Connection selection is intentionally separate and occurs before the main date/time window.
    $connectionSettings=if($ConnectionMode -eq 'Prompt'){Show-ConnectionSetupDialog}else{[pscustomobject]@{Mode=$ConnectionMode;Tenant=$DelegatedTenant;UPN=$SignInUserPrincipalName;UsePurview=(-not $SkipPurview);UseGraph=(-not $SkipGraph);UseSecurity=(-not $SkipSecurityData -and -not $SkipGraph);UseConditionalAccess=(-not $SkipConditionalAccess -and -not $SkipGraph);UseAzure=(-not $SkipAzure);UseSecureScore=(-not $SkipSecureScore -and -not $SkipGraph)}}
    if(-not $connectionSettings){Write-Log -Message 'User canceled before service connection.' -Level 'WARN' -Area 'UI';return}
    if($connectionSettings.Mode -eq 'Delegated' -and [string]::IsNullOrWhiteSpace([string]$connectionSettings.Tenant)){Show-ErrorMessage -Title 'Delegated tenant required' -Message 'Delegated mode requires a tenant ID or primary onmicrosoft.com domain.';return}
    $script:Connection.Mode=$connectionSettings.Mode;$script:Connection.Tenant=$connectionSettings.Tenant;$script:Connection.Account=$connectionSettings.UPN

    $progressOpen=$false
    Start-ProgressWindow -Title 'Connecting to Microsoft services before date selection';$progressOpen=$true
    Update-ReportProgress -Activity 'Connecting to Microsoft services' -Status 'Preparing Exchange Online, Purview, Microsoft Graph, and isolated Azure authentication.' -Percent 2
    Disconnect-ExistingSessions
    Invoke-SourceScopedOperation -Source 'Exchange Online and Purview connection' -Operation {Connect-ExchangeAndPurview -Mode $connectionSettings.Mode -Tenant $connectionSettings.Tenant -UPN $connectionSettings.UPN -UsePurview $connectionSettings.UsePurview}|Out-Null
    Invoke-SourceScopedOperation -Source 'Microsoft Graph connection' -Operation {Connect-GraphAudit -Tenant $connectionSettings.Tenant -UseGraph $connectionSettings.UseGraph -UseSecurity $connectionSettings.UseSecurity -UseConditionalAccess $connectionSettings.UseConditionalAccess -UseSecureScore $connectionSettings.UseSecureScore}|Out-Null
    $null=Resolve-TenantIdentity
    Invoke-SourceScopedOperation -Source 'Azure connection' -Operation {Connect-AzureAudit -Tenant $script:Connection.TenantId -UseAzure $connectionSettings.UseAzure}|Out-Null
    $null=Resolve-TenantIdentity

    Set-ProgressContext -Source 'Inspecting tenant licenses' -Base 9 -Span 3
    $script:SourceData['Tenant Licensing']=@(Invoke-SourceScopedOperation -Source 'Tenant licensing' -RequiredPermission 'LicenseAssignment.Read.All plus Directory Readers or Global Reader' -Operation {Collect-TenantLicensing})
    Update-ReportProgress -Activity 'Inspecting audit configuration' -Status 'Reading Unified Audit enablement, Exchange admin audit age limit, and custom Purview retention policies.' -Percent 12
    $script:SourceData['Audit Configuration']=@(Invoke-SourceScopedOperation -Source 'Audit configuration and retention metadata' -Operation {Collect-AuditConfigurationV2})
    if($connectionSettings.UseAzure){Set-ProgressContext -Source 'Inspecting Azure Activity Log export retention' -Base 13 -Span 2;Invoke-SourceScopedOperation -Source 'Azure retention configuration' -Operation {Collect-AzureAuditData -Enabled $true -From (Get-Date) -To (Get-Date) -Maximum 0 -ConfigurationOnly}|Out-Null}
    Invoke-SourceScopedOperation -Source 'Retention assessment' -Operation {$null=Get-TenantAuditRetentionAssessment -Licenses @($script:SourceData['Tenant Licensing']) -AuditConfiguration @($script:SourceData['Audit Configuration'])}|Out-Null
    Update-ReportProgress -Activity 'Tenant retention assessment complete' -Status ("Connected tenant: {0}. Opening the maximized date/time selection window." -f $script:ResolvedTenantLabel) -Percent 15
    if($progressOpen){Stop-ProgressWindow -Status 'Connections and retention inspection are complete.';$progressOpen=$false}

    $settings=[pscustomobject]@{Action='Collect';Mode=$connectionSettings.Mode;Tenant=$script:ResolvedTenantLabel;UPN=$script:Connection.Account;Start=$defaultStart;End=$defaultEnd;Maximum=$MaxRecordsPerSource;UsePurview=$connectionSettings.UsePurview;UseGraph=$connectionSettings.UseGraph;UseSecurity=$connectionSettings.UseSecurity;UseConditionalAccess=$connectionSettings.UseConditionalAccess;UseAzure=$connectionSettings.UseAzure;UseSecureScore=$connectionSettings.UseSecureScore}
    if($ConnectionMode -eq 'Prompt'){
        while($true){
            $selected=Show-RunConfigurationDialog -DefaultStart $settings.Start -DefaultEnd $settings.End -RetentionSummary $script:RetentionSummary -AlreadyConnected $true -PreviousSettings $settings
            if(-not $selected){Write-Log -Message 'User canceled after service connection.' -Level 'WARN' -Area 'UI';return}
            if($selected.Start -ge $selected.End){Show-ErrorMessage -Title 'Invalid date and time range' -Message 'The selected start date and time must be earlier than the end date and time.';continue}
            $settings=$selected
            if($settings.Action -ne 'CheckRetention'){break}
            Start-ProgressWindow -Title 'Refreshing tenant audit retention';$progressOpen=$true
            Set-ProgressContext -Source 'Refreshing tenant license inventory' -Base 5 -Span 4
            $script:SourceData['Tenant Licensing']=@(Invoke-SourceScopedOperation -Source 'Tenant licensing refresh' -Operation {Collect-TenantLicensing})
            $script:SourceData['Audit Configuration']=@(Invoke-SourceScopedOperation -Source 'Audit configuration refresh' -Operation {Collect-AuditConfigurationV2})
            if($settings.UseAzure){Set-ProgressContext -Source 'Refreshing Azure retention routes' -Base 10 -Span 4;Invoke-SourceScopedOperation -Source 'Azure retention refresh' -Operation {Collect-AzureAuditData -Enabled $true -From (Get-Date) -To (Get-Date) -Maximum 0 -ConfigurationOnly}|Out-Null}
            Invoke-SourceScopedOperation -Source 'Retention assessment refresh' -Operation {$null=Get-TenantAuditRetentionAssessment -Licenses @($script:SourceData['Tenant Licensing']) -AuditConfiguration @($script:SourceData['Audit Configuration'])}|Out-Null
            Stop-ProgressWindow -Status 'Retention information refreshed.';$progressOpen=$false
        }
    }

    Start-ProgressWindow -Title 'Collecting Microsoft 365, Entra, Azure, and security evidence';$progressOpen=$true
    $tenantForLog=if($script:ResolvedTenantLabel){$script:ResolvedTenantLabel}elseif($script:Connection.TenantId){$script:Connection.TenantId}else{$settings.Tenant}
    Write-Log -Message ("Starting collection. Mode={0}; Tenant={1}; Window={2:u} to {3:u}; MaxPerSource={4}" -f $settings.Mode,$tenantForLog,$settings.Start,$settings.End,$settings.Maximum) -Area 'START'
    foreach($retention in $script:RetentionAssessmentRows){if((Get-NestedValue $retention 'OldestSearchableDate') -and $settings.Start -lt [datetime](Get-NestedValue $retention 'OldestSearchableDate')){Write-Log -Message ("Requested start {0:u} predates the calculated native oldest searchable date for {1}: {2:u}. The source may return only retained data." -f $settings.Start,(Get-NestedValue $retention 'Source'),[datetime](Get-NestedValue $retention 'OldestSearchableDate')) -Level 'WARN' -Area 'RETENTION'}}

    Set-ProgressContext -Source 'Microsoft Purview Unified Audit Log' -Base 15 -Span 18
    if($settings.UsePurview){$script:SourceData['Purview Unified Audit Log']=@(Invoke-SourceScopedOperation -Source 'Purview Unified Audit Log' -RequiredPermission 'Purview Audit/Audit Reader role' -Operation {Collect-UnifiedAuditLog -From $settings.Start -To $settings.End -Maximum $settings.Maximum -MinimumSliceMinutes $MinimumAuditSliceMinutes})}else{Add-CollectionStatus -Source 'Purview Unified Audit Log' -Status 'Skipped' -Details 'Purview collection was disabled.'}
    Set-ProgressContext -Source 'Audit configuration activation and change evidence' -Base 33 -Span 4
    if($settings.UsePurview){$script:SourceData['Audit Configuration Change Evidence']=@(Invoke-SourceScopedOperation -Source 'Audit Configuration Change Evidence' -Operation {Collect-AuditConfigurationChangeEvidence})}else{Add-CollectionStatus -Source 'Audit Configuration Change Evidence' -Status 'Skipped' -Details 'Purview collection was disabled.'}
    Set-ProgressContext -Source 'Exchange administrator audit log' -Base 37 -Span 4
    if($settings.UsePurview){$script:SourceData['Exchange Admin Audit Log']=@(Invoke-SourceScopedOperation -Source 'Exchange Admin Audit Log' -Operation {Collect-ExchangeAdminAuditLog -From $settings.Start -To $settings.End -Maximum $settings.Maximum})}else{Add-CollectionStatus -Source 'Exchange Admin Audit Log' -Status 'Skipped' -Details 'Exchange audit collection was disabled.'}
    if($settings.UseGraph){Invoke-SourceScopedOperation -Source 'Microsoft Graph audit source group' -Operation {Collect-GraphSources -From $settings.Start -To $settings.End -Maximum $settings.Maximum -UseSecurity $settings.UseSecurity}|Out-Null}else{foreach($name in @('Entra Sign-ins','Entra Directory Audits','Entra Provisioning','Entra Risk Detections','Entra Risky Users','Defender Alerts','Defender Incidents')){Add-CollectionStatus -Source $name -Status 'Skipped' -Details 'Microsoft Graph collection was disabled.'}}
    Set-ProgressContext -Source 'Microsoft Entra Conditional Access policies' -Base 68 -Span 6
    $script:SourceData['Conditional Access Policies']=@(Invoke-SourceScopedOperation -Source 'Conditional Access policies' -Operation {Collect-ConditionalAccessPolicies -Enabled $settings.UseConditionalAccess -Maximum $settings.Maximum})
    Set-ProgressContext -Source 'Azure subscriptions, diagnostic settings, and Activity Logs' -Base 74 -Span 10
    Invoke-SourceScopedOperation -Source 'Azure source group' -Operation {Collect-AzureAuditData -Enabled $settings.UseAzure -From $settings.Start -To $settings.End -Maximum $settings.Maximum}|Out-Null
    Set-ProgressContext -Source 'Microsoft Secure Score' -Base 84 -Span 8
    Invoke-SourceScopedOperation -Source 'Microsoft Secure Score source group' -Operation {Collect-SecureScoreData -Enabled $settings.UseSecureScore -Maximum $settings.Maximum}|Out-Null

    Update-ReportProgress -Activity 'Analyzing suspicious activity and security posture' -Status 'Correlating all successful sources. Failed sources remain visible in Errors and Status.' -Percent 93
    Invoke-SourceScopedOperation -Source 'Analysis engine' -Operation {Invoke-SuspiciousActivityAnalysis}|Out-Null
    Invoke-SourceScopedOperation -Source 'Audit source detail builder' -Operation {Build-AuditSourceDetails}|Out-Null
    Invoke-SourceScopedOperation -Source 'Regression expectation evaluator' -Operation {$null=Evaluate-RegressionExpectations}|Out-Null
    Update-ReportProgress -Activity 'Generating tabbed HTML and evidence files' -Status 'Writing successful data and all source-scoped errors/status rows.' -Percent 97
    $report=New-HtmlReport -From $settings.Start -To $settings.End -Folder $ReportFolder
    if($progressOpen){Stop-ProgressWindow -Status 'Report and evidence files are complete.';$progressOpen=$false}
    if(-not $NoAutoOpen){try{Start-Process -FilePath $report|Out-Null}catch{Write-Log -Message "Could not open the report automatically: $($_.Exception.Message)" -Level 'WARN' -Area 'REPORT'}}
    $summary=[pscustomobject]@{ReportPath=$report;LogFile=$script:LogFile;Tenant=$tenantForLog;Account=$script:Connection.Account;Start=$settings.Start;End=$settings.End;Findings=$script:Findings.Count;Critical=@($script:Findings|Where-Object Severity -eq 'CRITICAL').Count;High=@($script:Findings|Where-Object Severity -eq 'HIGH').Count;Medium=@($script:Findings|Where-Object Severity -eq 'MEDIUM').Count;Sources=$script:CollectionStatus.Count;LimitedSources=@($script:CollectionStatus|Where-Object{$_.Status -notin @('Collected','VerifiedEmpty')}).Count;RetentionSummary=$script:RetentionSummary}
    Write-Log -Message ("Completed. Tenant={0}; Findings={1}; Critical={2}; High={3}; Report={4}" -f $tenantForLog,$summary.Findings,$summary.Critical,$summary.High,$summary.ReportPath) -Level 'SUCCESS' -Area 'COMPLETE'
    return $summary
}


<#
EXAMPLES

Interactive run (recommended):
    powershell.exe -STA -NoExit -ExecutionPolicy Bypass -File .\M365-Audit-Security-Report-v3.ps1

Regular tenant, last 14 days, no startup settings dialog:
    .\M365-Audit-Security-Report-v3.ps1 -ConnectionMode Regular -DaysBack 14

Delegated customer tenant:
    .\M365-Audit-Security-Report-v3.ps1 -ConnectionMode Delegated -DelegatedTenant customer.onmicrosoft.com -DaysBack 7

Explicit interval and higher collection limit:
    .\M365-Audit-Security-Report-v3.ps1 -ConnectionMode Regular -StartDate '2026-11-01 00:00:00' -EndDate '2026-11-08 00:00:00' -MaxRecordsPerSource 100000

Dot-source without immediately running:
    . .\M365-Audit-Security-Report-v3.ps1
    Start-M365AuditSecurityReport

REQUIRED ACCESS (workload dependent)
    Exchange Online: View-Only Audit Logs/Audit Logs role for Search-AdminAuditLog.
    Microsoft Purview: Audit or Audit Reader role for Search-UnifiedAuditLog.
    Microsoft Graph core: AuditLog.Read.All and Directory.Read.All delegated consent.
    Identity Protection: IdentityRiskEvent.Read.All and IdentityRiskyUser.Read.All plus appropriate licensing/role.
    Defender XDR: SecurityAlert.Read.All and SecurityIncident.Read.All plus product access.
    Conditional Access: Policy.Read.All plus a supported Microsoft Entra role.
    Secure Score: SecurityEvents.Read.All.
    Azure Activity Log: Azure Reader or Microsoft.Insights/eventtypes/values/read on each subscription.
    Azure diagnostic exports: Microsoft.Insights/diagnosticSettings/read.
#>

if ($MyInvocation.InvocationName -ne '.') {
    try { Start-M365AuditSecurityReport }
    catch {
        $message="Unexpected failure at line $($_.InvocationInfo.ScriptLineNumber): $($_.Exception.Message)"
        if($script:ProgressForm){try{Stop-ProgressWindow -Status ('Collection stopped because of an error: '+$_.Exception.Message)}catch{}}
        Write-Log -Message $message -Level 'ERROR' -Area 'FATAL'
        Show-ErrorMessage -Title "$script:ProductName - Unexpected Error" -Message $message
        Write-Host ($_ | Format-List * -Force | Out-String) -ForegroundColor DarkRed
        [void](Read-Host 'Press Enter to close')
    }
    finally { Disconnect-ExistingSessions }
}

