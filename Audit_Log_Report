            $rows.Add([pscustomobject]@{ Source='Exchange and Purview'; ConfigurationType='Admin and Unified Audit configuration'; Name=[string](Get-NestedValue $value 'Name'); Enabled=[string](Get-NestedValue $value 'UnifiedAuditLogIngestionEnabled'); Retention=[string](Get-NestedValue $value 'AdminAuditLogAgeLimit'); Priority=''; Scope='Tenant'; ChangedTime=[string](Get-NestedValue $value 'WhenChangedUTC'); Details=(ConvertTo-FlatText $value); RawJson=(ConvertTo-CompactJson $value) })
