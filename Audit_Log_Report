    $script:RetentionAssessmentRows.Add([pscustomobject]@{ Source='Entra risky sign-ins and detections'; RetentionDays=$riskDays; SearchableFor=$(if($riskDays){"Up to $riskDays days based on detected Entra tier"}else{'Could not determine because tenant licensing was unavailable'}); OldestSearchableDate=$(if($riskDays){$now.AddDays(-$riskDays)}else{$null}); OldestPotentialDate=$(if($riskDays){$now.AddDays(-$riskDays)}else{$null}); Basis='Detected Entra tier'; Confidence=$(if($riskDays){'License-derived'}else{'Unknown'}); Limitation='Identity Protection licensing, role access, remediation state, and API availability still control what is returned.' })

    $adminConfig=@($AuditConfiguration | Where-Object ConfigurationType -eq 'Admin and Unified Audit configuration' | Select-Object -First 1)
