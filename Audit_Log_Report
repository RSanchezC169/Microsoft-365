    }
    if ($script:Connection.Purview -and (Get-Command Get-UnifiedAuditLogRetentionPolicy -ErrorAction SilentlyContinue)) {
        try {
            foreach ($value in @(Get-UnifiedAuditLogRetentionPolicy -ErrorAction Stop | Sort-Object Priority)) {
                $rows.Add([pscustomobject]@{ Source='Microsoft Purview'; ConfigurationType='Custom audit retention policy'; Name=[string](Get-NestedValue $value 'Name'); Enabled='Configured'; Retention=[string](Get-NestedValue $value 'RetentionDuration'); Priority=[string](Get-NestedValue $value 'Priority'); Scope=("RecordTypes={0}; Operations={1}; Users={2}" -f (ConvertTo-FlatText (Get-NestedValue $value 'RecordTypes')),(ConvertTo-FlatText (Get-NestedValue $value 'Operations')),(ConvertTo-FlatText (Get-NestedValue $value 'UserIds'))); ChangedTime='Not exposed by this cmdlet'; Details=[string](Get-NestedValue $value 'Description'); RawJson=(ConvertTo-CompactJson $value) })
            }
