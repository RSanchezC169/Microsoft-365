function Collect-AuditConfigurationChangeEvidence {
    if(-not $script:Connection.Purview -or -not (Get-Command Search-UnifiedAuditLog -ErrorAction SilentlyContinue)){
        Add-CollectionStatus -Source 'Audit Configuration Change Evidence' -Status 'Unavailable' -RequiredPermission 'Purview Audit/Audit Reader role' -Details 'A verified Purview audit search session was not available.'
        return @()
    }
    $ret=@($script:RetentionAssessmentRows|Where-Object Source -eq 'Purview Unified Audit Log'|Select-Object -First 1)
    $from=if($ret.Count -and (Get-NestedValue $ret[0] 'OldestPotentialDate')){[datetime](Get-NestedValue $ret[0] 'OldestPotentialDate')}else{(Get-Date).AddDays(-180)}
    $to=Get-Date;$sliceDays=30;$rows=New-Object System.Collections.Generic.List[object];$seen=@{};$failures=New-Object System.Collections.Generic.List[string]
    $totalSlices=[Math]::Max(1,[int][Math]::Ceiling(($to-$from).TotalDays/$sliceDays));$cursor=$from;$slice=0
    while($cursor -lt $to){
        $slice++;$sliceEnd=$cursor.AddDays($sliceDays);if($sliceEnd -gt $to){$sliceEnd=$to}
        Update-SourceProgress -Status ("Audit configuration change slice {0}/{1}: {2:u} through {3:u}; matches={4}" -f $slice,$totalSlices,$cursor,$sliceEnd,$rows.Count) -Fraction (($slice-1)/$totalSlices) -CurrentItem ($slice-1) -TotalItems $totalSlices
        try{
            $sessionId=[guid]::NewGuid().ToString();$sliceCount=0
            while($sliceCount -lt 50000){
                $batch=@(Search-UnifiedAuditLog -StartDate $cursor.ToUniversalTime() -EndDate $sliceEnd.ToUniversalTime() -Operations 'Set-AdminAuditLogConfig' -SessionId $sessionId -SessionCommand ReturnLargeSet -ResultSize 5000 -ErrorAction Stop)
                if($batch.Count -eq 0){break}
                foreach($record in $batch){$key=Get-RecordKey $record @('Identity','AuditData');if(-not $seen.ContainsKey($key)){$seen[$key]=$true;try{$rows.Add((ConvertFrom-UalRecord $record))}catch{Write-Log -Message ("Audit configuration record normalization failed and was skipped: {0}" -f (ConvertTo-SafeErrorText $_)) -Level 'WARN' -Area 'NORMALIZE'}}}
                $sliceCount+=$batch.Count;if($batch.Count -lt 5000){break}
            }
        }catch{$message=("{0:u} through {1:u}: {2}" -f $cursor,$sliceEnd,(ConvertTo-SafeErrorText $_));$failures.Add($message);Write-Log -Message ("Audit configuration evidence slice failed but later slices will continue: {0}" -f $message) -Level 'WARN' -Area 'UAL'}
        $cursor=$sliceEnd
    }
    $status=if($failures.Count){'Partial'}elseif($rows.Count){'Collected'}else{'VerifiedEmpty'}
    $details=if($rows.Count){"Found $($rows.Count) retained Set-AdminAuditLogConfig event(s) in $totalSlices bounded 30-day slice(s)."}else{"No retained Set-AdminAuditLogConfig event was found in $totalSlices bounded 30-day slice(s). This does not prove auditing was never enabled or changed; older evidence can be expired, license-scoped, or outside the accessible audit record set."}
    if($failures.Count){$details+=" $($failures.Count) slice(s) failed; successful slices remain usable. First failure: $($failures[0])"}
    Add-CollectionStatus -Source 'Audit Configuration Change Evidence' -Status $status -Count $rows.Count -RequiredPermission 'Purview Audit/Audit Reader role' -Details $details
    Update-SourceProgress -Status ("Audit configuration change search complete: {0} retained event(s), {1} failed slice(s)" -f $rows.Count,$failures.Count) -Fraction 1 -CurrentItem $totalSlices -TotalItems $totalSlices
    return $rows.ToArray()
}


function Invoke-UnifiedAuditSearchInterval {
    param([datetime]$From,[datetime]$To,[int]$Maximum,[int]$MinimumSliceMinutes)
    $result = New-Object System.Collections.Generic.List[object]
    $sessionId = [guid]::NewGuid().ToString()
    $hitSessionLimit = $false
    while ($result.Count -lt 50000 -and $result.Count -lt $Maximum) {
        $remaining = [Math]::Min(5000,[Math]::Min(50000-$result.Count,$Maximum-$result.Count))
        if ($remaining -le 0) { break }
        $batch = @(Search-UnifiedAuditLog -StartDate $From -EndDate $To -SessionId $sessionId -SessionCommand ReturnLargeSet -ResultSize $remaining -ErrorAction Stop)
        if ($batch.Count -eq 0) { break }
        foreach ($record in $batch) { if ($result.Count -lt $Maximum) { $result.Add($record) } }
        if ($batch.Count -lt $remaining) { break }
        if ($result.Count -ge 50000) { $hitSessionLimit=$true; break }
        try {
            $last = $batch[-1]
            if ($last.ResultIndex -ge $last.ResultCount) { break }
        }
        catch { }
    }
    if ($hitSessionLimit -and (($To-$From).TotalMinutes -gt $MinimumSliceMinutes)) {
        $mid = $From.AddTicks([long](($To-$From).Ticks/2))
        Write-Log -Message ("UAL interval {0:u} to {1:u} reached 50,000 records; splitting it." -f $From,$To) -Level 'WARN' -Area 'UAL'
        $left = Invoke-UnifiedAuditSearchInterval -From $From -To $mid -Maximum $Maximum -MinimumSliceMinutes $MinimumSliceMinutes
        $remainingMaximum = [Math]::Max(0,$Maximum-$left.Count)
        $right = if ($remainingMaximum -gt 0) { Invoke-UnifiedAuditSearchInterval -From $mid -To $To -Maximum $remainingMaximum -MinimumSliceMinutes $MinimumSliceMinutes } else { @() }
        return @($left + $right)
    }
    return $result.ToArray()
}

function Collect-UnifiedAuditLog {
    param([datetime]$From,[datetime]$To,[int]$Maximum,[int]$MinimumSliceMinutes)
    if (-not $script:Connection.Purview -or -not (Get-Command Search-UnifiedAuditLog -ErrorAction SilentlyContinue)) {
        Add-CollectionStatus -Source 'Purview Unified Audit Log' -Status 'Unavailable' -RequiredPermission 'Purview Audit/Audit Reader role' -Details 'A verified Purview audit session was not available.'
        return @()
    }
    $raw = New-Object System.Collections.Generic.List[object]
    $seen = @{}
    $cursor = $From
    $truncated = $false
    $totalSlices=[Math]::Max(1,[int][Math]::Ceiling(($To-$From).TotalDays))
    $sliceNumber=0
    try {
        while ($cursor -lt $To -and $raw.Count -lt $Maximum) {
            $sliceNumber++
            $sliceEnd = $cursor.AddDays(1)
            if ($sliceEnd -gt $To) { $sliceEnd=$To }
            Update-SourceProgress -Status ("Unified Audit batch {0}/{1}: {2:u} through {3:u}; {4} records collected" -f $sliceNumber,$totalSlices,$cursor,$sliceEnd,$raw.Count) -Fraction (($sliceNumber-1)/$totalSlices) -CurrentItem ($sliceNumber-1) -TotalItems $totalSlices
            Write-Log -Message ("Searching Unified Audit Log from {0:u} to {1:u}." -f $cursor,$sliceEnd) -Area 'UAL'
            $interval = @(Invoke-UnifiedAuditSearchInterval -From $cursor -To $sliceEnd -Maximum ($Maximum-$raw.Count) -MinimumSliceMinutes $MinimumSliceMinutes)
            foreach ($record in $interval) {
                if ($raw.Count -ge $Maximum) { $truncated=$true; break }
                $key = Get-RecordKey -Object $record -PreferredProperties @('Identity','AuditData')
                if (-not $seen.ContainsKey($key)) { $seen[$key]=$true; try{$raw.Add((ConvertFrom-UalRecord $record))}catch{Write-Log -Message ("Unified Audit record normalization failed and was skipped: {0}" -f (ConvertTo-SafeErrorText $_)) -Level 'WARN' -Area 'NORMALIZE'} }
            }
            $cursor=$sliceEnd
        }
        if ($cursor -lt $To -or $raw.Count -ge $Maximum) { $truncated=$true }
        $status = if ($raw.Count -eq 0) { 'VerifiedEmpty' } elseif ($truncated) { 'Partial' } else { 'Collected' }
        Add-CollectionStatus -Source 'Purview Unified Audit Log' -Status $status -Count $raw.Count -Truncated $truncated -RequiredPermission 'Purview Audit/Audit Reader role' -Details $(if ($truncated) { "Stopped at configured limit $Maximum." } else { 'Searched the complete requested interval in bounded slices.' })
        Update-SourceProgress -Status ("Unified Audit complete: {0} records from {1} day batch(es)" -f $raw.Count,$sliceNumber) -Fraction 1 -CurrentItem $totalSlices -TotalItems $totalSlices
    }
    catch {
        Add-CollectionStatus -Source 'Purview Unified Audit Log' -Status $(if ($raw.Count) { 'Partial' } else { 'Unavailable' }) -Count $raw.Count -RequiredPermission 'Purview Audit/Audit Reader role' -Details (ConvertTo-SafeErrorText $_)
    }
    return $raw.ToArray()
}

