function Collect-ExchangeAdminAuditLog {
    param([datetime]$From,[datetime]$To,[int]$Maximum)
    if (-not $script:Connection.Exchange -or -not (Get-Command Search-AdminAuditLog -ErrorAction SilentlyContinue)) {
        Add-CollectionStatus -Source 'Exchange Admin Audit Log' -Status 'Unavailable' -RequiredPermission 'Exchange View-Only Audit Logs or Audit Logs role' -Details 'Search-AdminAuditLog is not available in the connected session.'
        return @()
    }
    $rows = New-Object System.Collections.Generic.List[object]
    $seen = @{}
    $cursor=$From
    $truncated=$false
    $totalSlices=[Math]::Max(1,[int][Math]::Ceiling(($To-$From).TotalDays))
    $sliceNumber=0
    try {
        while ($cursor -lt $To -and $rows.Count -lt $Maximum) {
            $sliceNumber++
            $sliceEnd=$cursor.AddDays(1); if ($sliceEnd -gt $To) { $sliceEnd=$To }
            Update-SourceProgress -Status ("Exchange admin audit batch {0}/{1}; {2} records collected" -f $sliceNumber,$totalSlices,$rows.Count) -Fraction (($sliceNumber-1)/$totalSlices) -CurrentItem ($sliceNumber-1) -TotalItems $totalSlices
            $batch = @(Search-AdminAuditLog -StartDate $cursor -EndDate $sliceEnd -ResultSize 5000 -ErrorAction Stop)
            foreach ($record in $batch) {
                if ($rows.Count -ge $Maximum) { $truncated=$true; break }
                $key=Get-RecordKey $record @('Identity','RunDate')
                if (-not $seen.ContainsKey($key)) { $seen[$key]=$true; try{$rows.Add((ConvertFrom-AdminAuditRecord $record))}catch{Write-Log -Message ("Exchange admin audit record normalization failed and was skipped: {0}" -f (ConvertTo-SafeErrorText $_)) -Level 'WARN' -Area 'NORMALIZE'} }
            }
            if ($batch.Count -ge 5000) {
                Write-Log -Message ("Exchange admin audit slice {0:u} to {1:u} returned 5,000 records and might be service-truncated." -f $cursor,$sliceEnd) -Level 'WARN' -Area 'EXO-AUDIT'
                $truncated=$true
            }
            $cursor=$sliceEnd
        }
        if ($cursor -lt $To -or $rows.Count -ge $Maximum) { $truncated=$true }
        $status=if ($rows.Count -eq 0) {'VerifiedEmpty'} elseif ($truncated) {'Partial'} else {'Collected'}
        Add-CollectionStatus -Source 'Exchange Admin Audit Log' -Status $status -Count $rows.Count -Truncated $truncated -RequiredPermission 'Exchange View-Only Audit Logs or Audit Logs role' -Details 'Collected in one-day slices.'
        Update-SourceProgress -Status ("Exchange admin audit complete: {0} records" -f $rows.Count) -Fraction 1 -CurrentItem $totalSlices -TotalItems $totalSlices
    }
    catch { Add-CollectionStatus -Source 'Exchange Admin Audit Log' -Status $(if ($rows.Count) {'Partial'}else{'Unavailable'}) -Count $rows.Count -RequiredPermission 'Exchange View-Only Audit Logs or Audit Logs role' -Details (ConvertTo-SafeErrorText $_) }
    return $rows.ToArray()
}

