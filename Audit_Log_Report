    $sources=@(
        [pscustomobject]@{Name='Purview Unified Audit Log';Workload='Microsoft 365 and Purview';Permission='Purview Audit or Audit Reader';License='Audit Standard/Premium and record-generating user licensing determine retention';Enablement=$(if(@($script:SourceData['Audit Configuration']|Where-Object ConfigurationType -eq 'Admin and Unified Audit configuration'|Where-Object Enabled -eq 'True').Count){'Unified audit ingestion reports enabled'}else{'Enablement not verified'});ChangedBy=$(if($ualChange.Count){$ualChange[0].UserId}else{'Not available in retained evidence'});ChangedTime=$(if($ualChange.Count){$ualChange[0].CreationTime}elseif($auditConfigChange.Count){$auditConfigChange[0].ChangedTime}else{''});Limit='Retention is evaluated per record, user license, workload, and highest-priority matching custom policy.'}
