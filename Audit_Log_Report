        catch { Add-CollectionStatus -Source 'Audit retention configuration' -Status 'Partial' -Details (ConvertTo-SafeErrorText $_) }
    }
    if ($rows.Count -eq 0) { Add-CollectionStatus -Source 'Audit configuration and retention metadata' -Status 'Unavailable' -Details 'No configuration collector returned data.' }
