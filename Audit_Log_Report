            'Exchange Admin Audit Log'{ConvertTo-CompactJson @($script:SourceData['Audit Configuration']|Where-Object ConfigurationType -eq 'Admin and Unified Audit configuration')}
            'Azure Activity Logs'{ConvertTo-CompactJson @($script:SourceData['Azure Diagnostic Settings'])}
            'Conditional Access Policies'{ConvertTo-CompactJson @($script:SourceData['Conditional Access Policies'])}
            'Secure Score History'{ConvertTo-CompactJson @($script:SourceData['Secure Score Control Profiles'])}
            default{ConvertTo-CompactJson @($script:SourceData['Tenant Licensing'])}
        }
        $script:SourceConfigurationRows.Add([pscustomobject]@{
            Source=$source.Name;Workload=$source.Workload;EnabledOrActivation=$source.Enablement;ChangedBy=$source.ChangedBy;ChangedTime=$source.ChangedTime
            Retention=$(if($ret.Count){$ret[0].SearchableFor}else{'Not exposed as one source-wide value'});OldestSearchableDate=$(if($ret.Count){$ret[0].OldestSearchableDate}else{$null});OldestEventFound=$earliest
            Licensing=$source.License;RequiredPermissions=$source.Permission;CollectionStatus=$(if($status.Count){$status[0].Status}else{'Not attempted'});Records=$rows.Count;Limitations=$source.Limit;RawConfiguration=$rawConfig
        })
    }
    $script:SourceData['Audit Source Configuration']=$script:SourceConfigurationRows.ToArray()
}

function Evaluate-RegressionExpectations {
    $script:RegressionRows.Clear()
    $expectations=@(
        [pscustomobject]@{Source='Purview Unified Audit Log';Baseline='User test returned a successful UAL collection';ExpectedCount=$null},
        [pscustomobject]@{Source='Entra Sign-ins';Baseline='User test returned successful Entra collection';ExpectedCount=$null},
        [pscustomobject]@{Source='Entra Directory Audits';Baseline='User test returned successful Entra collection';ExpectedCount=$null},
        [pscustomobject]@{Source='Conditional Access policies';Baseline='User test returned successful Conditional Access collection';ExpectedCount=$null},
        [pscustomobject]@{Source='Defender Alerts';Baseline='User test returned successful Defender Alerts collection';ExpectedCount=$null},
        [pscustomobject]@{Source='Secure Score History';Baseline='User test returned successful Secure Score History collection';ExpectedCount=$null},
        [pscustomobject]@{Source='Secure Score Control Profiles';Baseline='User test returned 460 Secure Score Control Profiles';ExpectedCount=460}
    )
    foreach($expectation in $expectations){
        $status=@($script:CollectionStatus|Where-Object Source -eq $expectation.Source|Select-Object -Last 1);$actualCount=@($script:SourceData[$expectation.Source]).Count
        $collectionState=if($status.Count){[string](Get-NestedValue $status[0] 'Status')}else{'Not attempted'}
        $result=if($collectionState -in @('Collected','VerifiedEmpty','Partial')){'PASS'}elseif($collectionState -eq 'Skipped'){'NOT RUN'}else{'REVIEW'}
        $note=$expectation.Baseline
        if($null -ne $expectation.ExpectedCount -and $actualCount -ne [int]$expectation.ExpectedCount){$result=if($result -eq 'PASS'){'INFO'}else{$result};$note+=". Current count is $actualCount; count changes are informational because Microsoft can add or retire controls."}
        $script:RegressionRows.Add([pscustomobject]@{Source=$expectation.Source;RegressionBaseline=$expectation.Baseline;CollectionStatus=$collectionState;ExpectedCount=$expectation.ExpectedCount;ActualCount=$actualCount;Result=$result;Notes=$note})
    }
    $script:SourceData['Regression Expectations']=$script:RegressionRows.ToArray()
    return $script:RegressionRows.ToArray()
}

function New-RawTabHtml {
    param([string]$Name,[object[]]$Rows,[string]$TableId,[string[]]$PreferredProperties)
    $properties=Get-ObjectProperties $Rows $PreferredProperties
    $table=ConvertTo-HtmlTable -Rows $Rows -Properties $properties -TableId $TableId -RawJsonExpandable -EmptyMessage "No rows were returned from $Name. Review Collection Coverage to distinguish verified-empty from unavailable."
    return "<div class='intro'><b>Raw source:</b> $(ConvertTo-HtmlEncoded $Name). Values are displayed as returned or normalized from that source; use the expandable RawJson field for the complete event payload.</div>$table"
}

