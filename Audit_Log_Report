function Write-Log {
    param(
        [Parameter(Mandatory=$true)][string]$Message,
        [ValidateSet('DEBUG','INFO','SUCCESS','WARN','ERROR')][string]$Level = 'INFO',
        [string]$Area = 'GENERAL'
    )
    $line = '{0} [{1}] [{2}] {3}' -f (Get-Date -Format 'yyyy-MM-dd HH:mm:ss'),$Level,$Area,$Message
    if ($script:LogFile) {
        try { Add-Content -LiteralPath $script:LogFile -Value $line -Encoding UTF8 } catch { }
    }
    $color = switch ($Level) {
        'SUCCESS' { 'Green' }
        'WARN' { 'Yellow' }
        'ERROR' { 'Red' }
        'DEBUG' { 'DarkGray' }
        default { 'Gray' }
    }
    Write-Host $line -ForegroundColor $color
}

function ConvertTo-SafeErrorText {
    param([AllowNull()][object]$ErrorObject)
    if ($null -eq $ErrorObject) { return 'No error details were returned.' }
    try {
        if ($ErrorObject -is [System.Management.Automation.ErrorRecord]) {
            return ('{0} [Category={1}; ErrorId={2}]' -f $ErrorObject.Exception.Message,$ErrorObject.CategoryInfo.Category,$ErrorObject.FullyQualifiedErrorId)
        }
        if ($ErrorObject -is [System.Exception]) { return $ErrorObject.Message }
        return [string]$ErrorObject
    }
    catch { return 'The error could not be normalized.' }
}

function Add-EnvironmentRow {
    param([string]$Check,[ValidateSet('PASS','WARN','FAIL','INFO')][string]$Status,[string]$Details)
    $script:EnvironmentRows.Add([pscustomobject]@{ Check=$Check; Status=$Status; Details=$Details })
}

function Add-CollectionStatus {
    param(
        [string]$Source,
        [string]$Status,
        [int]$Count = 0,
        [string]$Details = '',
        [string]$RequiredPermission = '',
        [bool]$Truncated = $false
    )
    $script:CollectionStatus.Add([pscustomobject]@{
        Source = $Source
        Status = $Status
        Count = $Count
        Truncated = $Truncated
        RequiredPermission = $RequiredPermission
        Details = $Details
        Timestamp = Get-Date
    })
    $level = if ($Status -eq 'Collected' -or $Status -eq 'VerifiedEmpty') { 'SUCCESS' } elseif ($Status -in @('Unavailable','Skipped','Partial')) { 'WARN' } else { 'ERROR' }
    Write-Log -Message ("{0}: {1}; Count={2}; Truncated={3}; {4}" -f $Source,$Status,$Count,$Truncated,$Details) -Level $level -Area 'COLLECT'
}

function Invoke-SourceScopedOperation {
    param([Parameter(Mandatory=$true)][string]$Source,[Parameter(Mandatory=$true)][scriptblock]$Operation,[string]$RequiredPermission='')
    try{return & $Operation}
    catch{
        $details=ConvertTo-SafeErrorText $_
        Add-CollectionStatus -Source $Source -Status 'Unavailable' -RequiredPermission $RequiredPermission -Details ("Unexpected source-scoped error: {0}. Other collectors and HTML generation will continue." -f $details)
        Write-Log -Message ("{0} failed without stopping the report: {1}" -f $Source,$details) -Level 'ERROR' -Area 'COLLECT'
        return @()
    }
}

function Test-TcpEndpoint {
    param([string]$HostName,[int]$Port=443,[int]$TimeoutMilliseconds=3000)
    $client = $null
    try {
        $client = New-Object System.Net.Sockets.TcpClient
        $async = $client.BeginConnect($HostName,$Port,$null,$null)
        if (-not $async.AsyncWaitHandle.WaitOne($TimeoutMilliseconds,$false)) { return $false }
        $client.EndConnect($async)
        return $client.Connected
    }
    catch { return $false }
    finally { if ($client) { try { $client.Close() } catch { } } }
}

