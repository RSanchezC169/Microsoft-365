}


function ConvertTo-CompactJson {
    param([AllowNull()][object]$Object,[int]$Depth=30)
    if ($null -eq $Object) { return '' }
    try { return ($Object | ConvertTo-Json -Depth $Depth -Compress) }
    catch { return [string]$Object }
}

function Get-NestedValue {
    param([AllowNull()][object]$Object,[Parameter(Mandatory=$true)][string]$Path)
    if ($null -eq $Object) { return $null }
    $current = $Object
    foreach ($segment in $Path.Split('.')) {
        if ($null -eq $current) { return $null }
        if ($current -is [System.Collections.IDictionary] -and $current.Contains($segment)) {
            $current = $current[$segment]
            continue
        }
        $property = $current.PSObject.Properties[$segment]
        if ($null -eq $property) { return $null }
        $current = $property.Value
    }
    return $current
}

function ConvertTo-FlatText {
    param([AllowNull()][object]$Value)
    if ($null -eq $Value) { return '' }
    if ($Value -is [string]) { return $Value }
    if ($Value -is [System.Collections.IDictionary]) {
        return (($Value.GetEnumerator() | ForEach-Object { '{0}={1}' -f $_.Key,(ConvertTo-FlatText $_.Value) }) -join '; ')
    }
    if ($Value -is [System.Collections.IEnumerable]) {
        return (($Value | ForEach-Object { ConvertTo-FlatText $_ }) -join '; ')
    }
    return [string]$Value
}

function Get-RecordKey {
    param([object]$Object,[string[]]$PreferredProperties)
    foreach ($name in $PreferredProperties) {
        $value = Get-NestedValue -Object $Object -Path $name
        if ($null -ne $value -and -not [string]::IsNullOrWhiteSpace([string]$value)) { return [string]$value }
    }
    $json = ConvertTo-CompactJson $Object
    $sha = [System.Security.Cryptography.SHA256]::Create()
    try {
        $bytes = [Text.Encoding]::UTF8.GetBytes($json)
        return ([BitConverter]::ToString($sha.ComputeHash($bytes))).Replace('-','')
    }
    finally { $sha.Dispose() }
}

function Invoke-GraphPagedCollection {
    param(
        [Parameter(Mandatory=$true)][string]$Source,
        [Parameter(Mandatory=$true)][string]$Uri,
        [Parameter(Mandatory=$true)][scriptblock]$Normalizer,
        [string]$RequiredPermission = '',
        [int]$Maximum = 50000
    )
    $rows = New-Object System.Collections.Generic.List[object]
    $seen = @{}
    $next = $Uri
    $truncated = $false
    $pageNumber = 0
    $normalizationErrors = 0
    try {
        while ($next -and $rows.Count -lt $Maximum) {
            $pageNumber++
            Update-SourceProgress -Status ("{0}: requesting page {1}; {2} records collected" -f $Source,$pageNumber,$rows.Count) -Fraction ([Math]::Min(0.88,$pageNumber*0.08))
            $response = Invoke-MgGraphRequest -Method GET -Uri $next -OutputType PSObject -ErrorAction Stop
            $items = @()
            if ($response -is [System.Collections.IDictionary] -and $response.Contains('value')) {
                $items = @($response['value'])
            }
            else {
                $valueProperty = $response.PSObject.Properties['value']
                if ($valueProperty) { $items = @($valueProperty.Value) }
                else { $items = @($response) }
            }
            foreach ($item in $items) {
                if ($rows.Count -ge $Maximum) { $truncated=$true; break }
                $key = Get-RecordKey -Object $item -PreferredProperties @('id','correlationId','activityDateTime','createdDateTime')
                if (-not $seen.ContainsKey($key)) {
                    $seen[$key]=$true
                    try {
                        $normalized=& $Normalizer $item
                        if($null -ne $normalized){$rows.Add($normalized)}
                    }
                    catch {
                        $normalizationErrors++
                        if($normalizationErrors -le 10){Write-Log -Message ("{0} record normalization failed and the record was skipped: {1}" -f $Source,(ConvertTo-SafeErrorText $_)) -Level 'WARN' -Area 'NORMALIZE'}
                    }
                }
            }
            if ($response -is [System.Collections.IDictionary] -and $response.Contains('@odata.nextLink')) {
                $next = [string]$response['@odata.nextLink']
            }
            else {
                $nextProperty = $response.PSObject.Properties['@odata.nextLink']
                $next = if ($nextProperty) { [string]$nextProperty.Value } else { $null }
            }
            if ($next -and $rows.Count -ge $Maximum) { $truncated=$true }
        }
        $status = if ($normalizationErrors -gt 0 -or $truncated) { 'Partial' } elseif ($rows.Count -eq 0) { 'VerifiedEmpty' } else { 'Collected' }
        $detail=if($truncated){"Stopped at the configured limit of $Maximum records."}else{'All returned pages were collected.'}
        if($normalizationErrors){$detail+=" $normalizationErrors malformed or schema-variant record(s) were skipped without stopping the source."}
        Add-CollectionStatus -Source $Source -Status $status -Count $rows.Count -Truncated $truncated -RequiredPermission $RequiredPermission -Details $detail
        Update-SourceProgress -Status ("{0}: complete; {1} records across {2} page(s)" -f $Source,$rows.Count,$pageNumber) -Fraction 1
    }
    catch {
        $status = if ($rows.Count -gt 0) { 'Partial' } else { 'Unavailable' }
        Add-CollectionStatus -Source $Source -Status $status -Count $rows.Count -Truncated $false -RequiredPermission $RequiredPermission -Details (ConvertTo-SafeErrorText $_)
    }
    return $rows.ToArray()
}

function Convert-RetentionDurationToDays {
    param([AllowNull()][object]$Value)
    if ($null -eq $Value) { return $null }
    if ($Value -is [TimeSpan]) { return [int][Math]::Ceiling($Value.TotalDays) }
    $text=[string]$Value
    switch -Regex ($text) {
        '^7\s*Days?$|SevenDays' { return 7 }
        '^30\s*Days?$|ThirtyDays|OneMonth' { return 30 }
        'ThreeMonths' { return 90 }
        'SixMonths' { return 180 }
        'NineMonths' { return 270 }
        'TwelveMonths|OneYear' { return 365 }
        'ThreeYears' { return 1095 }
        'FiveYears' { return 1825 }
        'SevenYears' { return 2555 }
        'TenYears' { return 3650 }
        '^(\d+)\.(\d+):' { try { return [int][TimeSpan]::Parse($text).TotalDays } catch { } }
        '^(\d+)\s*days?$' { return [int]$matches[1] }
    }
    return $null
}

function Collect-TenantLicensing {
    if (-not $script:Connection.Graph) {
        Add-CollectionStatus -Source 'Tenant licensing' -Status 'Unavailable' -RequiredPermission 'LicenseAssignment.Read.All (least privileged) or Directory.Read.All, plus Directory Readers or Global Reader' -Details 'Microsoft Graph was not connected.'
        return @()
    }
    # subscribedSkus supports $select but not $top or $filter. Using the bare endpoint avoids Graph BadRequest responses.
    $rows=Invoke-GraphPagedCollection -Source 'Tenant licensing' -Uri 'https://graph.microsoft.com/v1.0/subscribedSkus' -RequiredPermission 'LicenseAssignment.Read.All plus a supported directory role (Directory Readers or Global Reader)' -Maximum 2000 -Normalizer {
        param($item)
        $plans=@();$enabledPlans=@()
        foreach ($plan in @(Get-NestedValue $item 'servicePlans')) {
            $plans += ('{0}:{1}' -f (Get-NestedValue $plan 'servicePlanName'),(Get-NestedValue $plan 'provisioningStatus'))
            if([string](Get-NestedValue $plan 'provisioningStatus') -match '(?i)success|enabled'){$enabledPlans += [string](Get-NestedValue $plan 'servicePlanName')}
        }
        [pscustomobject]@{
            SkuPartNumber=Get-NestedValue $item 'skuPartNumber'; SkuId=Get-NestedValue $item 'skuId'; CapabilityStatus=Get-NestedValue $item 'capabilityStatus'
            ConsumedUnits=Get-NestedValue $item 'consumedUnits'; EnabledUnits=Get-NestedValue $item 'prepaidUnits.enabled'; WarningUnits=Get-NestedValue $item 'prepaidUnits.warning'
            ServicePlans=($plans -join '; '); EnabledServicePlans=($enabledPlans -join '; '); RawJson=ConvertTo-CompactJson $item
        }
    }
    return @($rows)
}

function Get-TenantLicenseCapabilities {
    param([object[]]$Licenses)
    $text=(@($Licenses | Where-Object CapabilityStatus -match '(?i)enabled|warning' | ForEach-Object { "{0} {1}" -f $_.SkuPartNumber,$_.EnabledServicePlans }) -join ' ').ToUpperInvariant()
    $p2=($text -match 'AAD_PREMIUM_P2|ENTRA_ID_P2|IDENTITY_THREAT_PROTECTION')
    $p1=($p2 -or $text -match 'AAD_PREMIUM(?!_P2)|AAD_PREMIUM_P1|ENTRA_ID_P1')
    $auditPremium=($text -match 'M365_ADVANCED_AUDITING|ADVANCED_AUDIT|E5_E_DISCOVERY_AND_AUDIT|M365_E5|SPE_E5|ENTERPRISEPREMIUM|PURVIEW_SUITE|INFORMATION_PROTECTION_COMPLIANCE')
    $tenYear=($text -match '10.?YEAR.*AUDIT|AUDIT.*10.?YEAR')
    return [pscustomobject]@{ EntraP1=$p1; EntraP2=$p2; AuditPremium=$auditPremium; TenYearAudit=$tenYear; Evidence=$text }
}

function Collect-AuditConfigurationV2 {
