function Ensure-Module {
    param([Parameter(Mandatory=$true)][string]$Name)
    try {
        $module = Get-Module -ListAvailable -Name $Name | Sort-Object Version -Descending | Select-Object -First 1
        if (-not $module) {
            Write-Log -Message "Installing module $Name for CurrentUser." -Level 'WARN' -Area 'MODULE'
            if (-not (Get-PackageProvider -Name NuGet -ListAvailable -ErrorAction SilentlyContinue)) {
                Install-PackageProvider -Name NuGet -Scope CurrentUser -Force -ErrorAction Stop | Out-Null
            }
            Install-Module -Name $Name -Scope CurrentUser -Force -AllowClobber -Repository PSGallery -ErrorAction Stop
            $module = Get-Module -ListAvailable -Name $Name | Sort-Object Version -Descending | Select-Object -First 1
        }
        Import-Module $module.Path -Force -Global -ErrorAction Stop
        Write-Log -Message ("Imported {0} version {1}." -f $Name,$module.Version) -Level 'SUCCESS' -Area 'MODULE'
        return $true
    }
    catch {
        Write-Log -Message ("Could not prepare module {0}: {1}" -f $Name,(ConvertTo-SafeErrorText $_)) -Level 'ERROR' -Area 'MODULE'
        return $false
    }
}

