function Export-SourceJsonLines {
    param([string]$Folder)
    if (-not (Test-Path -LiteralPath $Folder)) { New-Item -Path $Folder -ItemType Directory -Force | Out-Null }
    $manifest=New-Object System.Collections.Generic.List[object]
    foreach ($entry in $script:SourceData.GetEnumerator()) {
        $safe=($entry.Key -replace '[^A-Za-z0-9_-]','_')
        $path=Join-Path $Folder ($safe+'.jsonl')
        $writer=New-Object IO.StreamWriter($path,$false,(New-Object Text.UTF8Encoding($false)))
        try { foreach ($row in @($entry.Value)) { $writer.WriteLine((ConvertTo-CompactJson $row 40)) } }
        finally { $writer.Dispose() }
        $manifest.Add([pscustomobject]@{ Source=$entry.Key; File=[IO.Path]::GetFileName($path); Count=@($entry.Value).Count; SHA256=(Get-FileHash -LiteralPath $path -Algorithm SHA256).Hash })
    }
    $manifestPath=Join-Path $Folder 'manifest.csv'
    $manifest | Export-Csv -LiteralPath $manifestPath -NoTypeInformation -Encoding UTF8
    return $manifest.ToArray()
}

function Get-EarliestSourceEvent {
    param([string]$Source,[object[]]$Rows)
    $property=switch($Source){
        'Purview Unified Audit Log'{'CreationTime'}'Exchange Admin Audit Log'{'RunDate'}'Entra Sign-ins'{'CreatedDateTime'}'Entra Directory Audits'{'ActivityDateTime'}'Entra Provisioning'{'ActivityDateTime'}
        'Entra Risk Detections'{'DetectedDateTime'}'Entra Risky Users'{'RiskLastUpdatedDateTime'}'Defender Alerts'{'CreatedDateTime'}'Defender Incidents'{'CreatedDateTime'}
        'Conditional Access Policies'{'CreatedDateTime'}'Azure Activity Logs'{'EventTimestamp'}'Secure Score History'{'CreatedDateTime'}default{''}
    }
    if(-not $property){return $null}
    $dates=@()
    foreach($row in @($Rows)){try{$value=$row.PSObject.Properties[$property].Value;if($value){$dates += [datetime]$value}}catch{}}
    if($dates.Count){return ($dates|Sort-Object|Select-Object -First 1)}
    return $null
}

function Build-AuditSourceDetails {
    $script:SourceConfigurationRows.Clear()
    $ualChangeCandidates=@($script:SourceData['Audit Configuration Change Evidence'])+@($script:SourceData['Purview Unified Audit Log']|Where-Object Operation -match '(?i)Set-AdminAuditLogConfig|AuditDisabled')
    $ualChange=@($ualChangeCandidates|Sort-Object {[datetime]$_.CreationTime} -Descending|Select-Object -First 1)
    $auditConfigChange=@($script:SourceData['Audit Configuration']|Where-Object ConfigurationType -eq 'Admin and Unified Audit configuration'|Select-Object -First 1)
    $caChange=@($script:SourceData['Entra Directory Audits']|Where-Object {"$($_.ActivityDisplayName) $($_.TargetResources)" -match '(?i)conditional access'}|Sort-Object {[datetime]$_.ActivityDateTime} -Descending|Select-Object -First 1)
