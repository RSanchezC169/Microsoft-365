function Test-SignInSuccess {
    param([object]$Row)
    $code=0
    try { $code=[int64]$Row.ErrorCode } catch { $code=-1 }
    return ($code -eq 0)
}

function Get-SeverityFromText {
    param([string]$Value,[string]$Default='MEDIUM')
    switch -Regex ($Value) {
        '(?i)critical|high' { return 'HIGH' }
        '(?i)medium|moderate' { return 'MEDIUM' }
        '(?i)low|informational|info' { return 'LOW' }
        default { return $Default }
    }
}

function Get-HaversineKilometers {
    param([double]$Lat1,[double]$Lon1,[double]$Lat2,[double]$Lon2)
    $radius=6371.0
    $toRad=[Math]::PI/180.0
    $dLat=($Lat2-$Lat1)*$toRad; $dLon=($Lon2-$Lon1)*$toRad
    $a=[Math]::Sin($dLat/2)*[Math]::Sin($dLat/2)+[Math]::Cos($Lat1*$toRad)*[Math]::Cos($Lat2*$toRad)*[Math]::Sin($dLon/2)*[Math]::Sin($dLon/2)
    $c=2*[Math]::Atan2([Math]::Sqrt($a),[Math]::Sqrt(1-$a))
    return $radius*$c
}

function Analyze-SignIns {
    param([object[]]$Rows)
    $legacyPattern='(?i)exchange activesync|other clients|imap|pop|smtp|mapi over http'
    foreach ($row in @($Rows)) {
        $success=Test-SignInSuccess $row
        $risk=[string]$row.RiskLevelAggregated
        if ($risk -match '(?i)^high$') {
            Add-Finding 'CRITICAL' 'Identity' 'High-risk sign-in' $row.CreatedDateTime $row.UserPrincipalName $row.IPAddress $row.AppDisplayName $row.ResourceDisplayName ("RiskState={0}; RiskDetail={1}; CA={2}" -f $row.RiskState,$row.RiskDetail,$row.ConditionalAccessStatus) 'Entra Sign-ins' $row.Id
        }
        elseif ($risk -match '(?i)^medium$') {
            Add-Finding 'HIGH' 'Identity' 'Medium-risk sign-in' $row.CreatedDateTime $row.UserPrincipalName $row.IPAddress $row.AppDisplayName $row.ResourceDisplayName ("RiskState={0}; RiskDetail={1}; CA={2}" -f $row.RiskState,$row.RiskDetail,$row.ConditionalAccessStatus) 'Entra Sign-ins' $row.Id
        }
        if ($success -and ([string]$row.ClientAppUsed -match $legacyPattern)) {
            Add-Finding 'MEDIUM' 'Identity' 'Successful legacy-client sign-in' $row.CreatedDateTime $row.UserPrincipalName $row.IPAddress $row.ClientAppUsed $row.ResourceDisplayName 'Legacy or non-modern client usage can bypass some modern controls depending on tenant configuration; validate against approved use.' 'Entra Sign-ins' $row.Id
        }
        if (-not $success -and ([string]$row.ConditionalAccessStatus -match '(?i)failure')) {
            Add-Finding 'LOW' 'Identity' 'Conditional Access blocked sign-in' $row.CreatedDateTime $row.UserPrincipalName $row.IPAddress $row.AppDisplayName $row.ResourceDisplayName ("ErrorCode={0}; FailureReason={1}" -f $row.ErrorCode,$row.FailureReason) 'Entra Sign-ins' $row.Id
        }
        if ($success -and ([string]$row.AuthenticationRequirement -match '(?i)singleFactorAuthentication')) {
            Add-Finding 'LOW' 'Identity' 'Single-factor successful sign-in' $row.CreatedDateTime $row.UserPrincipalName $row.IPAddress $row.AppDisplayName $row.ResourceDisplayName 'The event reports single-factor authentication. Confirm whether Conditional Access and authentication-strength requirements were expected.' 'Entra Sign-ins' $row.Id
        }
    }

    $failures=@($Rows | Where-Object { -not (Test-SignInSuccess $_) })
    foreach ($group in @($failures | Group-Object UserPrincipalName,IPAddress)) {
        if ($group.Count -lt 10) { continue }
        $sample=$group.Group | Sort-Object CreatedDateTime | Select-Object -Last 1
        $severity=if ($group.Count -ge 50) {'HIGH'} elseif ($group.Count -ge 25) {'MEDIUM'} else {'LOW'}
        Add-Finding $severity 'Identity' 'Repeated sign-in failures' $sample.CreatedDateTime $sample.UserPrincipalName $sample.IPAddress 'Failed sign-ins' $sample.AppDisplayName ("{0} failed sign-ins from the same user/IP combination in the report window. Last error: {1} {2}" -f $group.Count,$sample.ErrorCode,$sample.FailureReason) 'Entra Sign-ins' $sample.Id
    }
    foreach ($group in @($failures | Group-Object IPAddress)) {
        $users=@($group.Group.UserPrincipalName | Where-Object { $_ } | Sort-Object -Unique)
        if ($group.Count -ge 25 -and $users.Count -ge 5) {
            $sample=$group.Group | Sort-Object CreatedDateTime | Select-Object -Last 1
            Add-Finding 'HIGH' 'Identity' 'Password-spray pattern' $sample.CreatedDateTime ($users -join ', ') $sample.IPAddress 'Failed sign-ins across users' '' ("{0} failures across {1} distinct users from one IP." -f $group.Count,$users.Count) 'Entra Sign-ins' $sample.Id
        }
    }

    foreach ($userGroup in @($Rows | Where-Object { (Test-SignInSuccess $_) -and $_.UserPrincipalName -and $_.Latitude -ne $null -and $_.Longitude -ne $null } | Group-Object UserPrincipalName)) {
        $events=@($userGroup.Group | Sort-Object { [datetime]$_.CreatedDateTime })
        for ($i=1;$i -lt $events.Count;$i++) {
            try {
                $previous=$events[$i-1]; $current=$events[$i]
                $hours=(([datetime]$current.CreatedDateTime)-([datetime]$previous.CreatedDateTime)).TotalHours
                if ($hours -le 0 -or $hours -gt 24) { continue }
                $distance=Get-HaversineKilometers ([double]$previous.Latitude) ([double]$previous.Longitude) ([double]$current.Latitude) ([double]$current.Longitude)
                $speed=$distance/$hours
                if ($distance -ge 500 -and $speed -ge 900) {
                    Add-Finding 'HIGH' 'Identity' 'Possible impossible travel' $current.CreatedDateTime $current.UserPrincipalName $current.IPAddress 'Successful sign-ins' ("{0}, {1} to {2}, {3}" -f $previous.City,$previous.Country,$current.City,$current.Country) ("Approximate distance {0:N0} km in {1:N1} hours ({2:N0} km/h). VPNs, mobile networks, and imprecise geolocation can cause false positives." -f $distance,$hours,$speed) 'Entra Sign-ins' $current.Id
                }
            }
            catch { }
        }
    }
}

function Analyze-DirectoryAudits {
    param([object[]]$Rows)
    foreach ($row in @($Rows)) {
        $activity=[string]$row.ActivityDisplayName
        $text="$activity $($row.TargetResources) $($row.AdditionalDetails)"
        $severity=$null; $rule=''
        switch -Regex ($text) {
            '(?i)add.*member.*role|eligible.*role|activate.*role|role assignment' { $severity='HIGH'; $rule='Privileged role membership or activation changed'; break }
            '(?i)consent.*application|oauth2permissiongrant|delegated permission grant|app role assignment' { $severity='HIGH'; $rule='Application consent or permission grant changed'; break }
            '(?i)add.*(password|secret|certificate|credential).*service principal|update application.*key|add service principal credentials' { $severity='CRITICAL'; $rule='Application or service-principal credential changed'; break }
            '(?i)conditional access.*(add|update|delete)|policy.*conditional access' { $severity='HIGH'; $rule='Conditional Access policy changed'; break }
            '(?i)federat.*domain|set domain authentication|verify domain' { $severity='CRITICAL'; $rule='Domain federation or authentication changed'; break }
            '(?i)authentication method|security info|strong authentication|password reset' { $severity='MEDIUM'; $rule='User authentication material changed'; break }
            '(?i)delete user|disable account|update user' { $severity='MEDIUM'; $rule='User lifecycle or account state changed'; break }
            '(?i)add member to group|remove member from group|update group' { $severity='LOW'; $rule='Group membership or configuration changed'; break }
        }
        if ($severity) {
            Add-Finding $severity 'Identity' $rule $row.ActivityDateTime $row.InitiatedBy $row.InitiatedByIP $activity $row.TargetResources ("Result={0}; Reason={1}; Service={2}" -f $row.Result,$row.ResultReason,$row.LoggedByService) 'Entra Directory Audits' $row.Id
        }
        if ([string]$row.Result -match '(?i)fail') {
            Add-Finding 'LOW' 'Identity' 'Failed directory administration action' $row.ActivityDateTime $row.InitiatedBy $row.InitiatedByIP $activity $row.TargetResources $row.ResultReason 'Entra Directory Audits' $row.Id
        }
    }
}

function Analyze-UnifiedAudit {
    param([object[]]$Rows)
    foreach ($row in @($Rows)) {
        $operation=[string]$row.Operation
        $context="$operation $($row.Parameters) $($row.RawJson)"
        $severity=$null; $category='Microsoft 365'; $rule=''
        if ($operation -match '(?i)New-InboxRule|Set-InboxRule|UpdateInboxRules') {
            $category='Exchange'
            if ($context -match '(?i)forward|redirect|delete|softdelete|markasread') { $severity='HIGH'; $rule='Suspicious inbox rule created or modified' }
            else { $severity='MEDIUM'; $rule='Inbox rule created or modified' }
        }
        elseif ($operation -match '(?i)Set-Mailbox' -and $context -match '(?i)ForwardingAddress|ForwardingSmtpAddress|DeliverToMailboxAndForward') { $severity='HIGH'; $category='Exchange'; $rule='Mailbox forwarding changed' }
        elseif ($operation -match '(?i)Add-MailboxPermission|Add-RecipientPermission|Set-MailboxFolderPermission|Add-MailboxFolderPermission') { $severity='HIGH'; $category='Exchange'; $rule='Mailbox delegation changed' }
        elseif ($operation -match '(?i)New-TransportRule|Set-TransportRule|Remove-TransportRule|Disable-TransportRule') { $severity='HIGH'; $category='Exchange'; $rule='Mail-flow rule changed' }
        elseif ($operation -match '(?i)AnonymousLinkCreated|AddedToSecureLink|SharingSet|SharingInvitationCreated') { $severity='MEDIUM'; $category='Data and Collaboration'; $rule='External or anonymous sharing changed' }
        elseif ($operation -match '(?i)SiteCollectionAdminAdded|AddedToGroup|CompanyLinkCreated') { $severity='MEDIUM'; $category='Data and Collaboration'; $rule='SharePoint or OneDrive access changed' }
        elseif ($operation -match '(?i)Add member to role|RoleAssignment|Consent to application|Add service principal credentials') { $severity='HIGH'; $category='Identity'; $rule='Privileged identity or application change' }
        elseif ($operation -match '(?i)FileDeleted|FolderDeleted') { $severity='LOW'; $category='Data and Collaboration'; $rule='File or folder deleted' }
        elseif ($operation -match '(?i)DlpRuleMatch|SecurityComplianceAlerts') { $severity='HIGH'; $category='Security'; $rule='Compliance or security alert activity' }
        if ($severity) { Add-Finding $severity $category $rule $row.CreationTime $row.UserId $row.ClientIP $operation $row.ObjectId ("Workload={0}; Result={1}; Parameters={2}" -f $row.Workload,$row.ResultStatus,$row.Parameters) 'Purview Unified Audit Log' $row.Id }
    }
    $massOps='(?i)FileDownloaded|FileDeleted|FileRecycled|FileAccessed|PageViewed|MessageBind|MailItemsAccessed'
    $massRows=@($Rows | Where-Object { [string]$_.Operation -match $massOps -and $_.UserId })
    foreach ($group in @($massRows | Group-Object { try { '{0}|{1}|{2:yyyy-MM-dd HH}' -f $_.UserId,$_.Operation,([datetime]$_.CreationTime) } catch { '{0}|{1}|unknown' -f $_.UserId,$_.Operation } })) {
        if ($group.Count -ge 200) {
            $sample=$group.Group | Select-Object -First 1
            $severity=if ($group.Count -ge 1000) {'HIGH'} else {'MEDIUM'}
            Add-Finding $severity 'Data and Collaboration' 'High-volume content activity' $sample.CreationTime $sample.UserId $sample.ClientIP $sample.Operation $sample.SiteUrl ("{0} events by the same user and operation in one hour. Confirm expected migration, sync, eDiscovery, backup, or administrative activity." -f $group.Count) 'Purview Unified Audit Log' $sample.Id
        }
    }
}

function Analyze-AdminAudit {
    param([object[]]$Rows)
    foreach ($row in @($Rows)) {
        $cmdlet=[string]$row.CmdletName; $context="$cmdlet $($row.Parameters)"
        $severity=$null; $rule=''
        switch -Regex ($context) {
            '(?i)New-InboxRule|Set-InboxRule|ForwardingAddress|ForwardingSmtpAddress' { $severity='HIGH'; $rule='Exchange forwarding or inbox rule administration'; break }
            '(?i)Add-MailboxPermission|Add-RecipientPermission|Add-MailboxFolderPermission|Set-MailboxFolderPermission' { $severity='HIGH'; $rule='Exchange delegation administration'; break }
            '(?i)New-TransportRule|Set-TransportRule|Remove-TransportRule|Disable-TransportRule' { $severity='HIGH'; $rule='Exchange mail-flow rule administration'; break }
            '(?i)Set-AdminAuditLogConfig|Set-OrganizationConfig.*Audit' { $severity='CRITICAL'; $rule='Audit configuration changed'; break }
            '(?i)New-ManagementRoleAssignment|Set-ManagementRoleAssignment|Remove-ManagementRoleAssignment' { $severity='HIGH'; $rule='Exchange RBAC assignment changed'; break }
            '(?i)Set-AcceptedDomain|New-InboundConnector|Set-InboundConnector|New-OutboundConnector|Set-OutboundConnector' { $severity='MEDIUM'; $rule='Exchange domain or connector changed'; break }
        }
        if ($severity) { Add-Finding $severity 'Exchange' $rule $row.RunDate $row.Caller '' $cmdlet $row.ObjectModified ("Succeeded={0}; ExternalAccess={1}; Parameters={2}; Error={3}" -f $row.Succeeded,$row.ExternalAccess,$row.Parameters,$row.Error) 'Exchange Admin Audit Log' $row.Id }
    }
}

function Analyze-SecuritySources {
    param([object[]]$RiskDetections,[object[]]$RiskyUsers,[object[]]$Alerts,[object[]]$Incidents,[object[]]$Provisioning)
    foreach ($row in @($RiskDetections)) {
        $severity=if ([string]$row.RiskLevel -match '(?i)high') {'CRITICAL'} elseif ([string]$row.RiskLevel -match '(?i)medium') {'HIGH'} else {'MEDIUM'}
        Add-Finding $severity 'Identity' ('Identity Protection: '+[string]$row.RiskEventType) $row.DetectedDateTime $row.UserPrincipalName $row.IPAddress $row.Activity $row.Location ("RiskState={0}; RiskDetail={1}; AdditionalInfo={2}" -f $row.RiskState,$row.RiskDetail,$row.AdditionalInfo) 'Entra Risk Detections' $row.Id
    }
    foreach ($row in @($RiskyUsers)) {
        if ([string]$row.RiskState -match '(?i)remediated|dismissed|none') { continue }
        $severity=if ([string]$row.RiskLevel -match '(?i)high') {'CRITICAL'} elseif ([string]$row.RiskLevel -match '(?i)medium') {'HIGH'} else {'MEDIUM'}
        Add-Finding $severity 'Identity' 'Risky user requires review' $row.RiskLastUpdatedDateTime $row.UserPrincipalName '' $row.RiskDetail '' ("RiskLevel={0}; RiskState={1}; IsDeleted={2}; IsProcessing={3}" -f $row.RiskLevel,$row.RiskState,$row.IsDeleted,$row.IsProcessing) 'Entra Risky Users' $row.Id
    }
    foreach ($row in @($Alerts)) {
        if ([string]$row.Status -match '(?i)resolved') { $default='LOW' } else { $default='MEDIUM' }
        $severity=Get-SeverityFromText ([string]$row.Severity) $default
        if ([string]$row.Severity -match '(?i)high') { $severity='HIGH' }
        Add-Finding $severity 'Security' ('Defender alert: '+[string]$row.Title) $row.CreatedDateTime $row.AssignedTo '' $row.Category $row.ServiceSource ("Status={0}; DetectionSource={1}; MITRE={2}; Description={3}" -f $row.Status,$row.DetectionSource,$row.MitreTechniques,$row.Description) 'Defender Alerts' $row.Id
    }
    foreach ($row in @($Incidents)) {
        if ([string]$row.Status -match '(?i)resolved') { continue }
        $severity=Get-SeverityFromText ([string]$row.Severity) 'MEDIUM'
        Add-Finding $severity 'Security' ('Defender incident: '+[string]$row.DisplayName) $row.CreatedDateTime $row.AssignedTo '' $row.Classification $row.Determination ("Status={0}; Alerts={1}; LastUpdate={2}" -f $row.Status,$row.AlertsCount,$row.LastUpdateDateTime) 'Defender Incidents' $row.Id
    }
    foreach ($row in @($Provisioning)) {
        if ([string]$row.Status -match '(?i)failure|error|warning') {
            Add-Finding 'LOW' 'Identity' 'Provisioning failure or warning' $row.ActivityDateTime $row.InitiatedBy '' $row.Action $row.TargetIdentity ("Status={0}; ErrorCode={1}; Reason={2}" -f $row.Status,$row.ErrorCode,$row.FailureReason) 'Entra Provisioning' $row.Id
        }
    }
}

function Analyze-ConditionalAccess {
    param([object[]]$Policies)
    if(@($Policies).Count -eq 0){
        $status=@($script:CollectionStatus|Where-Object Source -eq 'Conditional Access policies'|Select-Object -Last 1)
        if($status.Count -and $status[0].Status -eq 'VerifiedEmpty'){Add-Finding 'HIGH' 'Conditional Access' 'No Conditional Access policies exist' (Get-Date) '' '' 'Conditional Access posture' '' 'The policy endpoint completed successfully and returned zero policies.' 'Conditional Access policies' ''}
        return
    }
    $enabled=@($Policies|Where-Object State -eq 'enabled')
    $reportOnly=@($Policies|Where-Object State -eq 'enabledForReportingButNotEnforced')
    if($enabled.Count -eq 0){Add-Finding 'HIGH' 'Conditional Access' 'No enforced Conditional Access policies returned' (Get-Date) '' '' 'Conditional Access posture' '' ("{0} policies were returned, but none are in the enabled state. Report-only policies do not enforce controls." -f $Policies.Count) 'Conditional Access policies' ''}
    foreach($policy in $Policies){
        if($policy.State -eq 'disabled'){Add-Finding 'LOW' 'Conditional Access' 'Disabled Conditional Access policy' $policy.ModifiedDateTime '' '' $policy.DisplayName $policy.Id 'Review whether the disabled policy is obsolete, intentionally staged, or should be re-enabled.' 'Conditional Access policies' $policy.Id}
        elseif($policy.State -eq 'enabledForReportingButNotEnforced'){Add-Finding 'MEDIUM' 'Conditional Access' 'Report-only Conditional Access policy' $policy.ModifiedDateTime '' '' $policy.DisplayName $policy.Id 'The policy evaluates but does not enforce. Review sign-in impact and promotion plans.' 'Conditional Access policies' $policy.Id}
        if($policy.ExcludeUsers -or $policy.ExcludeGroups -or $policy.ExcludeRoles -or $policy.ExcludeLocations){Add-Finding 'LOW' 'Conditional Access' 'Conditional Access exclusions require review' $policy.ModifiedDateTime '' '' $policy.DisplayName $policy.Id ("Excluded users={0}; groups={1}; roles={2}; locations={3}" -f $policy.ExcludeUsers,$policy.ExcludeGroups,$policy.ExcludeRoles,$policy.ExcludeLocations) 'Conditional Access policies' $policy.Id}
        if($policy.State -eq 'enabled' -and [string]::IsNullOrWhiteSpace([string]$policy.BuiltInControls) -and [string]::IsNullOrWhiteSpace([string]$policy.AuthenticationStrengthId) -and [string]::IsNullOrWhiteSpace([string]$policy.SessionControls)){Add-Finding 'MEDIUM' 'Conditional Access' 'Enabled policy has no visible grant or session control' $policy.ModifiedDateTime '' '' $policy.DisplayName $policy.Id 'Validate the raw policy payload and intended enforcement behavior.' 'Conditional Access policies' $policy.Id}
    }
    if($reportOnly.Count -gt $enabled.Count -and $reportOnly.Count -gt 2){Add-Finding 'MEDIUM' 'Conditional Access' 'More report-only than enforced policies' (Get-Date) '' '' 'Conditional Access posture' '' ("Enforced={0}; Report-only={1}." -f $enabled.Count,$reportOnly.Count) 'Conditional Access policies' ''}
}

function Analyze-AzureActivity {
    param([object[]]$Rows)
    foreach($row in @($Rows)){
        $operation=[string]$row.OperationName;$text="$operation $($row.ResourceId) $($row.Properties)";$severity=$null;$rule=''
        switch -Regex($text){
            '(?i)roleAssignments/(write|delete)|elevateAccess|classicAdministrators'{$severity='HIGH';$rule='Azure privileged role assignment changed';break}
            '(?i)diagnosticSettings/(write|delete)|logProfiles/(write|delete)'{$severity='HIGH';$rule='Azure logging or diagnostic export changed';break}
            '(?i)policyAssignments/(write|delete)|policyDefinitions/(write|delete)'{$severity='MEDIUM';$rule='Azure Policy configuration changed';break}
            '(?i)Microsoft.KeyVault/.*/(delete|purge)|vaults/delete'{$severity='CRITICAL';$rule='Azure Key Vault deletion or purge operation';break}
            '(?i)networkSecurityGroups/.*/(write|delete)|firewallPolicies/.*/(write|delete)|publicIPAddresses/write'{$severity='HIGH';$rule='Azure network security configuration changed';break}
            '(?i)/delete$|/delete ' {$severity='MEDIUM';$rule='Azure resource deletion operation';break}
            '(?i)locks/(write|delete)'{$severity='MEDIUM';$rule='Azure resource lock changed';break}
        }
        if([string]$row.Status -match '(?i)failed' -and -not $severity){$severity='LOW';$rule='Failed Azure control-plane operation'}
        if($severity){Add-Finding $severity 'Azure' $rule $row.EventTimestamp $row.Caller '' $operation $row.ResourceId ("Status={0}; Subscription={1}; ResourceGroup={2}; CorrelationId={3}" -f $row.Status,$row.SubscriptionName,$row.ResourceGroupName,$row.CorrelationId) 'Azure Activity Logs' $row.EventDataId}
    }
}

function Analyze-SecureScore {
    param([object[]]$History,[object[]]$ControlResults)
    $latest=@($History|Sort-Object {try{[datetime](Get-NestedValue $_ 'CreatedDateTime')}catch{[datetime]::MinValue}} -Descending|Select-Object -First 1)
    if($latest.Count){
        $pct=Get-NestedValue $latest[0] 'ScorePercent';$scoreDate=Get-NestedValue $latest[0] 'CreatedDateTime';$scoreId=Get-NestedValue $latest[0] 'Id';$current=Get-NestedValue $latest[0] 'CurrentScore';$max=Get-NestedValue $latest[0] 'MaxScore'
        if($null -ne $pct -and [double]$pct -lt 40){Add-Finding 'HIGH' 'Secure Score' 'Microsoft Secure Score is below 40 percent' $scoreDate '' '' 'Secure Score posture' '' ("CurrentScore={0}; MaxScore={1}; Percent={2}" -f $current,$max,$pct) 'Secure Score History' $scoreId}
        elseif($null -ne $pct -and [double]$pct -lt 60){Add-Finding 'MEDIUM' 'Secure Score' 'Microsoft Secure Score is below 60 percent' $scoreDate '' '' 'Secure Score posture' '' ("CurrentScore={0}; MaxScore={1}; Percent={2}" -f $current,$max,$pct) 'Secure Score History' $scoreId}
    }
    foreach($control in @($ControlResults|Sort-Object {try{[double](Get-NestedValue $_ 'MaxScore')-[double](Get-NestedValue $_ 'CurrentScore')}catch{0}} -Descending|Select-Object -First 20)){
        $gap=0;try{$gap=[double](Get-NestedValue $control 'MaxScore')-[double](Get-NestedValue $control 'CurrentScore')}catch{}
        $implementation=[string](Get-NestedValue $control 'ImplementationStatus');$controlName=[string](Get-NestedValue $control 'ControlName')
        if($gap -ge 5 -and $implementation -notmatch '(?i)completed|resolved'){
            Add-Finding 'LOW' 'Secure Score' 'Secure Score improvement opportunity' (Get-NestedValue $control 'ScoreDate') '' '' (Get-NestedValue $control 'Title') $controlName ("Score gap={0:N2}; Status={1}; Category={2}; Service={3}. {4}" -f $gap,$implementation,(Get-NestedValue $control 'Category'),(Get-NestedValue $control 'Service'),(Get-NestedValue $control 'Remediation')) 'Secure Score Control Results' $controlName
        }
    }
}

function Invoke-SuspiciousActivityAnalysis {
    Analyze-SignIns @($script:SourceData['Entra Sign-ins'])
    Analyze-DirectoryAudits @($script:SourceData['Entra Directory Audits'])
    Analyze-UnifiedAudit @($script:SourceData['Purview Unified Audit Log'])
    Analyze-AdminAudit @($script:SourceData['Exchange Admin Audit Log'])
    Analyze-SecuritySources @($script:SourceData['Entra Risk Detections']) @($script:SourceData['Entra Risky Users']) @($script:SourceData['Defender Alerts']) @($script:SourceData['Defender Incidents']) @($script:SourceData['Entra Provisioning'])
    Analyze-ConditionalAccess @($script:SourceData['Conditional Access Policies'])
    Analyze-AzureActivity @($script:SourceData['Azure Activity Logs'])
    Analyze-SecureScore @($script:SourceData['Secure Score History']) @($script:SourceData['Secure Score Control Results'])
    $sorted=@(
        $script:Findings.ToArray() |
            Sort-Object `
                @{ Expression={
                    switch ($_.Severity) {
                        'CRITICAL' { 0 }
                        'HIGH' { 1 }
                        'MEDIUM' { 2 }
                        'LOW' { 3 }
                        default { 4 }
                    }
                } }, `
                @{ Expression={ try { [datetime]$_.Time } catch { [datetime]::MinValue } }; Descending=$true }
    )
    $script:Findings.Clear(); foreach ($row in $sorted) { $script:Findings.Add($row) }
    Write-Log -Message ("Generated {0} review findings." -f $script:Findings.Count) -Level 'SUCCESS' -Area 'ANALYZE'
}

function ConvertTo-HtmlEncoded {
    param([AllowNull()][object]$Value)
    if ($null -eq $Value) { return '' }
    return [System.Net.WebUtility]::HtmlEncode((ConvertTo-FlatText $Value))
}

function Get-ObjectProperties {
    param([object[]]$Rows,[string[]]$Preferred)
    $names=New-Object System.Collections.Generic.List[string]
    foreach ($name in @($Preferred)) { if (-not $names.Contains($name)) { $names.Add($name) } }
    foreach ($row in @($Rows | Select-Object -First 20)) {
        if($null -eq $row){continue}
        foreach ($property in $row.PSObject.Properties.Name) { if (-not $names.Contains($property)) { $names.Add($property) } }
    }
    return $names.ToArray()
}

function ConvertTo-HtmlTable {
    param(
        [object[]]$Rows,
        [string[]]$Properties,
        [string]$TableId,
        [string]$EmptyMessage='No records were returned.',
        [switch]$RawJsonExpandable
    )
    if (-not $Rows -or @($Rows).Count -eq 0) { return "<div class='empty'>$(ConvertTo-HtmlEncoded $EmptyMessage)</div>" }
    if (-not $Properties -or $Properties.Count -eq 0) { $Properties=Get-ObjectProperties $Rows @() }
    $builder=New-Object Text.StringBuilder
    [void]$builder.Append("<div class='table-tools'><input type='text' placeholder='Filter rows in this tab...' onkeyup=`"filterTable('$TableId',this.value)`"><span>Rows: $(@($Rows).Count)</span></div><div class='table-wrap'><table id='$TableId'><thead><tr>")
    foreach ($property in $Properties) { [void]$builder.Append("<th>$(ConvertTo-HtmlEncoded $property)</th>") }
    [void]$builder.Append('</tr></thead><tbody>')
    foreach ($row in @($Rows)) {
        if($null -eq $row){continue}
        $rowClass=''
        if ($row.PSObject.Properties['Severity']) { $rowClass=' sev-'+([string]$row.Severity).ToLowerInvariant() }
        [void]$builder.Append("<tr class='$rowClass'>")
        foreach ($property in $Properties) {
            $value=$null
            $p=$row.PSObject.Properties[$property]
            if ($p) { $value=$p.Value }
            if ($RawJsonExpandable -and $property -match '^(RawJson|RawConfiguration|ControlScoresJson)$' -and $value) {
                [void]$builder.Append("<td class='raw-cell'><details><summary>View underlying data</summary><pre>$(ConvertTo-HtmlEncoded $value)</pre></details></td>")
            }
            else { [void]$builder.Append("<td>$(ConvertTo-HtmlEncoded $value)</td>") }
        }
        [void]$builder.Append('</tr>')
    }
    [void]$builder.Append('</tbody></table></div>')
    return $builder.ToString()
}

function New-MetricCardsHtml {
    $critical=@($script:Findings | Where-Object Severity -eq 'CRITICAL').Count
    $high=@($script:Findings | Where-Object Severity -eq 'HIGH').Count
    $medium=@($script:Findings | Where-Object Severity -eq 'MEDIUM').Count
    $low=@($script:Findings | Where-Object { $_.Severity -in @('LOW','INFO') }).Count
    $collected=@($script:CollectionStatus | Where-Object { $_.Status -in @('Collected','VerifiedEmpty') }).Count
    $limited=@($script:CollectionStatus | Where-Object { $_.Status -notin @('Collected','VerifiedEmpty') }).Count
    return @"
<div class='metrics'>
<div class='metric critical'><span>$critical</span><b>Critical</b></div>
<div class='metric high'><span>$high</span><b>High</b></div>
<div class='metric medium'><span>$medium</span><b>Medium</b></div>
<div class='metric low'><span>$low</span><b>Low / Info</b></div>
<div class='metric good'><span>$collected</span><b>Collected sources</b></div>
<div class='metric warning'><span>$limited</span><b>Limited sources</b></div>
</div>
"@
